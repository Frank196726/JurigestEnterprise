@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Jurigest.Web.Models
@using Jurigest.Web.Security
@inject IJurigestApiClient Api
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationState
<div class="vehiculos-overlay" role="dialog" aria-modal="true" aria-label="Gestionar vehículos">
<div class="vehiculos-dialog">
<h2>Gestionar vehículos — @Rol</h2>
<fieldset><legend>Listado de vehículos en este encargo (@Vehiculos.Count)</legend>
@foreach (var vehiculo in Vehiculos)
{
    <fieldset><legend><strong>@vehiculo.Patente // @vehiculo.Marca @vehiculo.Modelo @vehiculo.Cilindrada @vehiculo.Color</strong></legend>
    <p>Nombre: @vehiculo.Nombre</p><p>Dirección: @vehiculo.Direccion</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-secondary" @onclick="() => Imprimir(vehiculo, false)">Imprimir formulario</button>
        <button type="button" class="btn btn-secondary" disabled="@_guardando" @onclick="() => Editar(vehiculo)">Modificar formulario</button>
        <button type="button" class="btn btn-secondary" @onclick="() => Imprimir(vehiculo, true)">Imprimir resumen</button>
        <button type="button" class="btn btn-outline-danger" disabled="@_guardando" @onclick="() => _eliminarId = vehiculo.Id">Eliminar</button>
    </div>
    @if (_eliminarId == vehiculo.Id)
    {
        <p class="mt-2">¿Eliminar el vehículo @vehiculo.Patente de este encargo?</p>
        <button type="button" class="btn btn-danger" disabled="@_guardando" @onclick="() => Eliminar(vehiculo)">Confirmar eliminación</button>
        <button type="button" class="btn btn-secondary" @onclick="() => _eliminarId = null">Cancelar</button>
    }
    </fieldset>
}
@if (Vehiculos.Count == 0) { <p>No hay vehículos registrados en este encargo.</p> }
</fieldset>
<fieldset><legend>Listado de notificados en este encargo (@Personas.Count)</legend>
<div style="overflow:auto"><table class="table table-bordered"><thead><tr><th>Nombre</th><th>Dirección / Comuna</th><th>Opciones</th></tr></thead><tbody>
@foreach (var persona in Personas)
{
    <tr><td>@persona</td><td>@string.Join("; ", Direcciones)</td><td><button type="button" class="btn btn-secondary" disabled="@_guardando" @onclick="() => Agregar(persona)">Agregar vehículo</button></td></tr>
}
</tbody></table></div>
@if (Personas.Count == 0) { <p>Complete el nombre del demandado antes de agregar vehículos.</p> }
</fieldset>
@if (_formulario is not null)
{
    <fieldset><legend>@(_editando ? "Modificar formulario" : "Agregar vehículo")</legend>
    <fieldset><legend>Datos del vehículo</legend><div class="vehiculo-form">
        <label>Tipo propietario<select class="form-select" @bind="_formulario.TipoPropietario"><option value="1">Persona natural</option><option value="2">Persona jurídica</option><option value="3">Extranjero</option><option value="4">Otro</option></select></label>
        <label>Patente vehículo *<input class="form-control" maxlength="20" @bind="_formulario.Patente" /></label>
        <VehiculoCatalogoSelect Categoria="tipos" Etiqueta="Tipo vehículo" @bind-Value="_formulario.TipoVehiculo" />
        <label>Año vehículo<select class="form-select" @bind="_formulario.Ano"><option value="">Seleccione...</option>@foreach(var ano in Enumerable.Range(1900, DateTime.Today.Year - 1900 + 2).Reverse()) { <option value="@ano">@ano</option> }</select></label>
        <VehiculoCatalogoSelect Categoria="marcas" Etiqueta="Marca vehículo *" @bind-Value="_formulario.Marca" />
        <label>Modelo vehículo *<input class="form-control" maxlength="200" @bind="_formulario.Modelo" /></label>
        <label>Color vehículo<input class="form-control" maxlength="100" @bind="_formulario.Color" /></label>
        <label>Cilindrada<input class="form-control" maxlength="50" @bind="_formulario.Cilindrada" /></label>
        <label>N° motor<input class="form-control" maxlength="100" @bind="_formulario.Motor" /></label>
        <label>N° serie / V.I.N.<input class="form-control" maxlength="200" @bind="_formulario.Serie" /></label>
        <label>N° chasis<input class="form-control" maxlength="100" @bind="_formulario.Chasis" /></label>
    </div></fieldset>
    <fieldset><legend>Datos de la solicitud</legend><div class="vehiculo-form">
        <label>Fecha documento<input class="form-control" type="date" @bind="_formulario.FechaDocumento" /></label>
        <VehiculoCatalogoSelect Categoria="adquisiciones" Etiqueta="Tipo adquisición" @bind-Value="_formulario.TipoAdquisicion" />
        <VehiculoCatalogoSelect Categoria="alzamientos" Etiqueta="Alzamiento o prohibición" @bind-Value="_formulario.AlzamientoProhibicion" />
        <VehiculoCatalogoSelect Categoria="limitaciones" Etiqueta="Limitación al dominio" @bind-Value="_formulario.LimitacionDominio" />
        <label>Lugar solicitud alzamiento<input class="form-control" maxlength="200" @bind="_formulario.LugarSolicitud" /></label>
        <label>N° solicitud alzamiento<input class="form-control" maxlength="200" @bind="_formulario.NumeroSolicitud" /></label>
        <VehiculoCatalogoSelect Categoria="documentos" Etiqueta="Tipo de documento" @bind-Value="_formulario.TipoDocumento" />
        <label>Derechos inscripción (CLP)<input class="form-control" type="number" min="0" step="1" @bind="_formulario.DerechosInscripcion" /></label>
        <label>Observaciones<textarea class="form-control" maxlength="1000" @bind="_formulario.Observaciones"></textarea></label>
    </div></fieldset>
    <fieldset><legend>Datos del titular</legend><div class="vehiculo-form">
        <label>Titular *<select class="form-select" @bind="_formulario.Nombre">
            @if (!Personas.Contains(_formulario.Nombre)) { <option value="@_formulario.Nombre">@_formulario.Nombre</option> }
            @foreach (var persona in Personas) { <option value="@persona">@persona</option> }
        </select></label>
        <label>RUT titular<input class="form-control" maxlength="20" @bind="_formulario.RutTitular" /></label>
        <label>Dirección / Comuna *<select class="form-select" @bind="_formulario.Direccion"><option value="">Seleccione...</option>
            @if (!string.IsNullOrWhiteSpace(_formulario.Direccion) && !Direcciones.Contains(_formulario.Direccion)) { <option value="@_formulario.Direccion">@_formulario.Direccion</option> }
            @foreach (var direccion in Direcciones) { <option value="@direccion">@direccion</option> }
        </select></label>
    </div></fieldset>
    <button type="button" class="btn btn-primary mt-3" disabled="@_guardando" @onclick="Guardar">Guardar vehículo</button>
    <button type="button" class="btn btn-secondary mt-3" disabled="@_guardando" @onclick="() => _formulario = null">Cancelar</button>
    </fieldset>
}
@if (!string.IsNullOrWhiteSpace(_error)) { <p class="text-danger" role="alert">@_error</p> }
@if (!DiligenciaId.HasValue) { <p class="mt-3">Los vehículos se guardarán al guardar la gestión.</p> }
<button type="button" class="btn btn-secondary mt-3" disabled="@_guardando" @onclick="Cerrar">Cerrar</button>
</div></div>
@code {
    [Parameter] public List<VehiculoModel> Vehiculos { get; set; } = new();
    [Parameter] public List<string> Personas { get; set; } = new();
    [Parameter] public List<string> Direcciones { get; set; } = new();
    [Parameter] public string Rol { get; set; } = "";
    [Parameter] public string Caratula { get; set; } = "";
    [Parameter] public string Tribunal { get; set; } = "";
    [Parameter] public Guid? DiligenciaId { get; set; }
    [Parameter] public EventCallback Cerrar { get; set; }
    private VehiculoModel? _formulario;
    private bool _editando, _guardando;
    private string? _error;
    private Guid? _eliminarId;
    private void Agregar(string persona) { _formulario = new() { Id = Guid.NewGuid(), Nombre = persona, Direccion = Direcciones.FirstOrDefault() ?? "" }; _editando = false; _error = null; }
    private void Editar(VehiculoModel v) { _formulario = System.Text.Json.JsonSerializer.Deserialize<VehiculoModel>(System.Text.Json.JsonSerializer.Serialize(v)); _editando = true; _error = null; }
    private async Task Guardar()
    {
        if (_formulario is null || _guardando) return;
        _error = null;
        if (string.IsNullOrWhiteSpace(_formulario.Nombre) || string.IsNullOrWhiteSpace(_formulario.Direccion) || string.IsNullOrWhiteSpace(_formulario.Patente) || string.IsNullOrWhiteSpace(_formulario.Marca) || string.IsNullOrWhiteSpace(_formulario.Modelo) || _formulario.Ano is < 1900 or > 2100)
        { _error = "Complete notificado, dirección, patente, marca y modelo; revise el año."; return; }
        _formulario.Patente = _formulario.Patente.Trim().ToUpperInvariant();
        if (Vehiculos.Any(v => v.Id != _formulario.Id && v.Patente.Equals(_formulario.Patente, StringComparison.OrdinalIgnoreCase))) { _error = "Esta patente ya está registrada."; return; }
        if (_formulario.TipoPropietario is < 1 or > 4 || _formulario.DerechosInscripcion < 0 || decimal.Truncate(_formulario.DerechosInscripcion) != _formulario.DerechosInscripcion)
        { _error = "Revise tipo de propietario y derechos de inscripción en pesos enteros."; return; }
        _guardando = true;
        try
        {
            var guardado = _formulario;
            if (DiligenciaId.HasValue)
            {
                var ruta = $"/api/diligencias/{DiligenciaId}/vehiculos";
                using var respuesta = _editando ? await Api.PutAsync($"{ruta}/{guardado.Id}", JsonContent.Create(guardado)) : await Api.PostAsync(ruta, JsonContent.Create(guardado));
                if (!respuesta.IsSuccessStatusCode) throw new InvalidOperationException(await respuesta.Content.ReadAsStringAsync());
                guardado = await respuesta.Content.ReadFromJsonAsync<VehiculoModel>() ?? throw new InvalidOperationException("No se recibió el vehículo.");
            }
            var anterior = Vehiculos.FindIndex(v => v.Id == _formulario.Id);
            if (anterior >= 0) Vehiculos[anterior] = guardado; else Vehiculos.Add(guardado);
            _formulario = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or UnauthorizedAccessException) { _error = ex is UnauthorizedAccessException ? "La sesión expiró. Inicie sesión nuevamente." : ex.Message; }
        finally { _guardando = false; }
    }
    private async Task Eliminar(VehiculoModel v)
    {
        _guardando = true;
        try
        {
            if (DiligenciaId.HasValue)
            {
                using var respuesta = await Api.DeleteAsync($"/api/diligencias/{DiligenciaId}/vehiculos/{v.Id}");
                if (!respuesta.IsSuccessStatusCode) throw new InvalidOperationException(await respuesta.Content.ReadAsStringAsync());
            }
            Vehiculos.Remove(v); _eliminarId = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or UnauthorizedAccessException) { _error = ex.Message; }
        finally { _guardando = false; }
    }
    private async Task Imprimir(VehiculoModel v, bool resumen)
    {
        if (!resumen)
        {
            try
            {
                var cuenta = await Api.GetAsync<UsuarioResumen>("/api/seguridad/mi-cuenta")
                    ?? throw new InvalidOperationException("No fue posible obtener los datos del solicitante.");
                await using var formulario = await JS.InvokeAsync<IJSObjectReference>("import", "./js/formulario-rvm.js");
                await formulario.InvokeVoidAsync("imprimirRvm", v, Rol, Tribunal,
                    new { cuenta.Nombre, cuenta.Direccion, cuenta.NumeroOficina, cuenta.Rut, cuenta.Telefono }, Caratula);
            }
            catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or InvalidOperationException)
            {
                _error = "No fue posible imprimir el formulario. " + ex.Message;
            }
            return;
        }
        var texto = $"ROL: {Rol} — {Tribunal}\nNombre: {v.Nombre.Split(" — ", 2)[0]}\nDirección: {v.Direccion}\n\nPatente: {v.Patente}\nMarca: {v.Marca}\nModelo: {v.Modelo}\nColor: {v.Color}\nCilindrada: {v.Cilindrada}\nAño: {v.Ano}";
        if (!resumen) texto += $"\nN° motor: {v.Motor}\nN° chasis: {v.Chasis}\nObservaciones: {v.Observaciones}\n\nFecha: ____________________\nFirma: ____________________";
        await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/imprimir-documento.js");
        await modulo.InvokeVoidAsync("imprimirDocumento", resumen ? "Resumen del vehículo" : "Formulario del vehículo", texto);
    }
}
