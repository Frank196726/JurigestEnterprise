@using Jurigest.Web.Security
@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<section class="upload-card">
    <div class="upload-heading">
        <div>
            <span class="eyebrow">
                Nuevo documento
            </span>

            <h2>Cargar archivo</h2>
        </div>

        <span class="file-limit">
            PDF, DOC o DOCX · Máximo 10 MB
        </span>
    </div>

    <div class="upload-grid">
        <label>
            <span>Nombre del documento</span>

            <input type="text"
                   maxlength="200"
                   placeholder="Ej.: Informe del receptor"
                   @bind="_nombreDocumento" />
        </label>

        <label>
            <span>Tipo</span>

            <select @bind="_tipoDocumento">
                <option value="1">Demanda</option>
                <option value="2">Contestación</option>
                <option value="3">Escrito</option>
                <option value="4">Resolución</option>
                <option value="5">Contrato</option>
                <option value="6">Informe</option>
                <option value="7">Poder</option>
                <option value="8">Anexo</option>
                <option value="99">Otro</option>
            </select>
        </label>

        <label class="file-field">
            <span>Archivo</span>

            @* La clave cambia tras cada carga para vaciar el selector y poder elegir el mismo archivo. *@
            <InputFile @key="_versionSelector"
                       OnChange="SeleccionarArchivo"
                       accept=".pdf,.doc,.docx" />
        </label>

        <button class="upload-button"
                type="button"
                disabled="@(_subiendo ||
                    _archivoSeleccionado is null ||
                    CausaId == Guid.Empty ||
                    string.IsNullOrWhiteSpace(
                        _nombreDocumento))"
                @onclick="CargarArchivoAsync">
            @(_subiendo
                ? "Cargando…"
                : "Cargar documento")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensajeCarga))
    {
        <div class="upload-message success"
             role="status">
            @_mensajeCarga
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorCarga))
    {
        <div class="upload-message error"
             role="alert">
            @_errorCarga
        </div>
    }
</section>
