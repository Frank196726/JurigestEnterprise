    private List<string> _personasMembrete = new(), _direccionesMembrete = new();
    private async Task AbrirMembreteAsync()
    {
        _cargandoMembrete = true;
        _personasMembrete.Clear(); _direccionesMembrete.Clear();
        void Persona(string? nombre, string rol) { if (!string.IsNullOrWhiteSpace(nombre)) _personasMembrete.Add($"{nombre.Trim()} — {rol}"); }
        void Direccion(string? direccion, string? comuna) { if (!string.IsNullOrWhiteSpace(direccion)) _direccionesMembrete.Add(string.Join(", comuna de ", new[] { direccion, comuna }.Where(x => !string.IsNullOrWhiteSpace(x)))); }
        void Parte(DemandadoGestionModel parte, string rol)
        {
            Persona(parte.Nombre, parte.TipoPersona == 2 ? $"{rol} / Razón social" : rol);
            Persona(parte.RepresentanteLegal, $"Representante de {parte.Nombre}");
        }
        Persona(_nuevaGestion.Demandado, _nuevaGestion.TipoPersonaDemandado == 2 ? "Demandado / Razón social" : "Demandado");
        Persona(_nuevaGestion.RepresentanteLegalDemandado, $"Representante de {_nuevaGestion.Demandado}");
        foreach (var parte in _nuevaGestion.OtrosDemandados) Parte(parte, "Demandado");
        foreach (var aval in _nuevaGestion.AvalesSolidarios) Parte(aval, "Aval solidario");
        Direccion(_nuevaGestion.Direccion, _nuevaGestion.Comuna);
        try
        {
            var rol = ObtenerRitResultante();
            if (!string.IsNullOrWhiteSpace(rol))
            {
                var causas = await ApiClient.GetAsync<List<CausaResumen>>("/api/Causas") ?? new();
                var tribunal = _tribunales.FirstOrDefault(x => x.Id == _nuevaGestion.TribunalId)?.Nombre;
                var existente = causas.FirstOrDefault(x => IdentificacionCausa.MismoRol(x.Rit, rol) && IdentificacionCausa.MismoTribunal(x.Tribunal, tribunal ?? ""));
                if (existente is not null)
                {
                    var causa = await ApiClient.GetAsync<CausaResumen>($"/api/Causas/{existente.Id}");
                    foreach (var parte in causa?.Demandados ?? [])
                    {
                        Persona(parte.Nombre, parte.TipoPersona == 2 ? "Demandado / Razón social" : "Demandado");
                        Persona(parte.RepresentanteLegal, $"Representante de {parte.Nombre}");
                        foreach (var aval in parte.Avales) { Persona(aval.Nombre, "Aval solidario"); Persona(aval.RepresentanteLegal, $"Representante de {aval.Nombre}"); }
                    }
                    var diligencias = await ApiClient.GetAsync<List<DiligenciaResumen>>($"/api/Diligencias/causa/{existente.Id}") ?? new();
                    foreach (var diligencia in diligencias) Direccion(diligencia.Direccion, diligencia.Comuna);
                }
            }
            _personasMembrete = _personasMembrete.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            _direccionesMembrete = _direccionesMembrete.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            _mostrarMembrete = true;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _mensajeGestion = "No fue posible cargar las partes y direcciones para el membrete."; }
        finally { _cargandoMembrete = false; }
    }

