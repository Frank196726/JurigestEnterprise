                            }));

                await VerificarRespuestaAsync(
                    response,
                    "agregar la comuna");

                var creada =
                    await response.Content
                        .ReadFromJsonAsync<CatalogoItem>();

                await CargarComunasAsync();

                _nuevaGestion.Comuna =
                    creada?.Nombre ?? nombre;

                _nuevaComuna =
                    string.Empty;

                _mostrarAgregarComuna =
                    false;

                _mensajeGestion =
                    $"Comuna {nombre} agregada correctamente.";
            });
    }


    private async Task CargarTiposDiligenciaAsync()
    {
        var resultado =
            await ApiClient.GetAsync<
                List<TipoDiligenciaItem>>(
                "/api/Catalogos/tipos-diligencia");

        _tiposDiligencia.Clear();

        if (resultado is not null)
        {
            _tiposDiligencia.AddRange(
                resultado);
        }
    }

    private void AlternarAgregarDiligencia()
    {
        _mostrarAgregarDiligencia =
            !_mostrarAgregarDiligencia;

        _mensajeGestion =
            null;

        if (_mostrarAgregarDiligencia &&
            !_nuevoCodigoTipoDiligencia.HasValue)
        {
            _nuevoCodigoTipoDiligencia =
                _tiposDiligencia
                    .FirstOrDefault(x => x.CodigoSistema.HasValue)?
                    .CodigoSistema;
        }

        if (!_mostrarAgregarDiligencia)
        {
            _nuevaDiligencia =
                string.Empty;

            _nuevoCodigoTipoDiligencia =
                null;
        }
    }

    private async Task AgregarDiligenciaAsync()
    {
        var nombre =
            _nuevaDiligencia.Trim();

        if (string.IsNullOrWhiteSpace(nombre))
        {
            _mensajeGestion =
                "Debe indicar el nombre de la diligencia.";

            return;
        }

        if (!_nuevoCodigoTipoDiligencia.HasValue)
        {
            _mensajeGestion =
                "Debe seleccionar el tipo de diligencia.";

            return;
        }

        await EjecutarCreacionCatalogoAsync(
            async () =>
            {
                using var response =
                    await ApiClient.PostAsync(
                        "/api/Catalogos/diligencias-encargadas",
                        JsonContent.Create(
                            new
                            {
                                nombre,

                                codigoTipoDiligencia =
                                    _nuevoCodigoTipoDiligencia
                            }));

                await VerificarRespuestaAsync(
                    response,
                    "agregar la diligencia");

                var creado =
                    await response.Content
                        .ReadFromJsonAsync<
                            DiligenciaEncargadaItem>();

                await CargarDiligenciasEncargadasAsync();

                if (creado is not null)
                {
                    _nuevaGestion.DiligenciaEncargadaId =
                        creado.Id;
                }

                _nuevaDiligencia =
                    string.Empty;

                _nuevoCodigoTipoDiligencia =
                    null;

                _mostrarAgregarDiligencia =
                    false;

                _mensajeGestion =
                    $"Diligencia {nombre} agregada correctamente.";
            });
    }

    private DiligenciaEncargadaItem?
        ObtenerDiligenciaEncargadaSeleccionada()
    {
        if (!_nuevaGestion
            .DiligenciaEncargadaId
            .HasValue)
        {
            return null;
        }

        return _diligenciasEncargadas
            .FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion
                        .DiligenciaEncargadaId
                        .Value);
    }

    // =========================================================
    // CREACIÓN GENÉRICA DE CATÁLOGOS
    // =========================================================

    private async Task EjecutarCreacionCatalogoAsync(
        Func<Task> accion)
    {
        _guardandoCatalogo =
            true;

        _gestionGuardada =
            false;

        _mensajeGestion =
            null;

        try
        {
            await accion();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException)
        {
            _mensajeGestion =
                ex.Message;
        }
        finally
        {
            _guardandoCatalogo =
                false;
        }
    }

    // =========================================================
    // VALORES INICIALES
    // =========================================================

    private void SeleccionarValoresIniciales()
    {
        if (!_nuevaGestion.TipoCausaId.HasValue &&
            _tiposCausa.Count > 0)
        {
            _nuevaGestion.TipoCausaId =
                (_tiposCausa.FirstOrDefault(x => string.Equals(x.Codigo, "C", StringComparison.OrdinalIgnoreCase))
                    ?? _tiposCausa[0]).Id;
        }

        if (!_nuevaGestion.TribunalId.HasValue &&
            _tribunales.Count > 0)
        {
            _nuevaGestion.TribunalId =
                _tribunales[0].Id;
        }

        if (!_nuevaGestion.AbogadoId.HasValue &&
            _abogados.Count > 0)
        {
            _nuevaGestion.AbogadoId =
                _abogados[0].Id;

            AsociarDemandanteConAbogado();
        }
    }

    private void AsociarDemandanteConAbogado()
    {
        var abogado = _abogados.FirstOrDefault(
            x => x.Id == _nuevaGestion.AbogadoId);

        var demandanteAsociado = abogado is null
            ? null
            : ObtenerDemandanteAsociado(abogado.Nombre);

        if (string.IsNullOrWhiteSpace(_nuevaGestion.Demandante) ||
            string.Equals(
                _nuevaGestion.Demandante,
                _demandanteAsociadoAnterior,
                StringComparison.Ordinal))
        {
            _nuevaGestion.Demandante =
                demandanteAsociado ?? string.Empty;
        }

        _demandanteAsociadoAnterior =
            demandanteAsociado;
    }

    private static string? ObtenerDemandanteAsociado(
        string nombreAbogado)
    {
        var inicio = nombreAbogado.IndexOf('(');

        if (inicio < 0)
        {
            return null;
        }

        var fin = nombreAbogado.IndexOf(')', inicio + 1);

        if (fin <= inicio + 1)
        {
            return null;
        }

        return nombreAbogado[(inicio + 1)..fin].Trim();
    }

    // =========================================================
    // ROL
    // =========================================================

    private string ObtenerRitResultante()
    {
        if (!_nuevaGestion.TipoCausaId.HasValue ||
            string.IsNullOrWhiteSpace(
                _nuevaGestion.NumeroRol))
        {
            return string.Empty;
        }

        var tipo =
            _tiposCausa.FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion
                        .TipoCausaId
                        .Value);

        if (tipo is null)
        {
            return string.Empty;
        }

        return
            $"{tipo.Codigo.Trim().ToUpperInvariant()}-" +
            $"{_nuevaGestion.NumeroRol.Trim()}";
    }

    private void AplicarRitInicial(
        string ritInicial)
    {
        var rit =
            IdentificacionCausa.NormalizarRol(ritInicial);

        if (string.IsNullOrWhiteSpace(
                rit))
        {
            return;
        }

        foreach (var tipo in
                 _tiposCausa
                     .OrderByDescending(
                         x => x.Codigo.Length))
        {
            var prefijo =
                $"{tipo.Codigo.Trim()}-";

            if (!rit.StartsWith(
                    prefijo,
                    StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            _nuevaGestion.TipoCausaId =
                tipo.Id;

            _nuevaGestion.NumeroRol =
                rit[prefijo.Length..]
                    .Trim();

            return;
        }

        _nuevaGestion.TipoCausaId =
            null;

        _nuevaGestion.NumeroRol =
            rit;
    }

    // =========================================================
    // RESPUESTAS HTTP
    // =========================================================

    private static async Task VerificarRespuestaAsync(
        HttpResponseMessage respuesta,
        string operacion)
    {
        if (respuesta.IsSuccessStatusCode)
        {
            return;
        }

        var detalle =
            await respuesta.Content
                .ReadAsStringAsync();

        throw new HttpRequestException(
            $"No se pudo {operacion} " +
            $"({(int)respuesta.StatusCode}). " +
            detalle);
    }

