    private static RegistrarGestionModel CrearModeloGestion()
    {
        return new RegistrarGestionModel
        {
            FechaEncargoCausa =
                DateTime.Today,

            FechaProgramada =
                DateTime.Today
        };
    }

    private static string ObtenerEstado(
        int estado)
    {
        return estado switch
        {
            1 => "Ingresada",
            2 => "En tramitación",
            3 => "Suspendida",
            4 => "Terminada",
            5 => "Archivada",
            _ => "Sin estado"
        };
    }

    private static string ObtenerTextoPrioridad(
        int diasSinGestion)
{
        return diasSinGestion switch
    {
            <= 10 => "Normal",
            <= 15 => "Requiere revisión",
            _ => "Atención prioritaria"
    };
}

    private static string ObtenerClasePrioridad(
        int diasSinGestion)
{
    return diasSinGestion switch
    {
            <= 10 => "priority-badge priority-normal",
            <= 15 => "priority-badge priority-review",
                _ => "priority-badge priority-critical"
    };
}

