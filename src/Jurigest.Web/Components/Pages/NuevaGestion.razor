    // =========================================================
    // CREACIÓN GENÉRICA DE CATÁLOGOS
    // =========================================================

    private async Task EjecutarCreacionCatalogoAsync(
        Func<Task> accion)
    {
        _guardandoCatalogo =
            true;

        _gestionGuardada =
            false;

        _mensajeGestion =
            null;

        try
        {
            await accion();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException)
        {
            _mensajeGestion =
                ex.Message;
        }
        finally
        {
            _guardandoCatalogo =
                false;
        }
    }

    // =========================================================
    // VALORES INICIALES
    // =========================================================

    private void SeleccionarValoresIniciales()
    {
        if (!_nuevaGestion.TipoCausaId.HasValue &&
            _tiposCausa.Count > 0)
        {
            _nuevaGestion.TipoCausaId =
                _tiposCausa[0].Id;
        }

        if (!_nuevaGestion.TribunalId.HasValue &&
            _tribunales.Count > 0)
        {
            _nuevaGestion.TribunalId =
                _tribunales[0].Id;
        }

        if (!_nuevaGestion.AbogadoId.HasValue &&
            _abogados.Count > 0)
        {
            _nuevaGestion.AbogadoId =
                _abogados[0].Id;
        }

        if (!_nuevaGestion
                .DiligenciaEncargadaId
                .HasValue &&
            _diligenciasEncargadas.Count > 0)
        {
            _nuevaGestion.DiligenciaEncargadaId =
                _diligenciasEncargadas[0].Id;
        }
    }

    // =========================================================
    // ROL
    // =========================================================

    private string ObtenerRitResultante()
    {
        if (!_nuevaGestion.TipoCausaId.HasValue ||
            string.IsNullOrWhiteSpace(
                _nuevaGestion.NumeroRol))
        {
            return string.Empty;
        }

        var tipo =
            _tiposCausa.FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion
                        .TipoCausaId
                        .Value);

        if (tipo is null)
        {
            return string.Empty;
        }

        return
            $"{tipo.Codigo.Trim().ToUpperInvariant()}-" +
            $"{_nuevaGestion.NumeroRol.Trim()}";
    }

    private void AplicarRitInicial(
        string ritInicial)
    {
        var rit =
            ritInicial.Trim();

        if (string.IsNullOrWhiteSpace(
                rit))
        {
            return;
        }

        foreach (var tipo in
                 _tiposCausa
                     .OrderByDescending(
                         x => x.Codigo.Length))
        {
            var prefijo =
                $"{tipo.Codigo.Trim()}-";

            if (!rit.StartsWith(
                    prefijo,
                    StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            _nuevaGestion.TipoCausaId =
                tipo.Id;

            _nuevaGestion.NumeroRol =
                rit[prefijo.Length..]
                    .Trim();

            return;
        }

        _nuevaGestion.TipoCausaId =
            null;

        _nuevaGestion.NumeroRol =
            rit;
    }

    // =========================================================
    // RESPUESTAS HTTP
    // =========================================================

    private static async Task VerificarRespuestaAsync(
        HttpResponseMessage respuesta,
        string operacion)
    {
        if (respuesta.IsSuccessStatusCode)
        {
            return;
        }

        var detalle =
            await respuesta.Content
                .ReadAsStringAsync();

        throw new HttpRequestException(
            $"No se pudo {operacion} " +
            $"({(int)respuesta.StatusCode}). " +
            detalle);
    }

