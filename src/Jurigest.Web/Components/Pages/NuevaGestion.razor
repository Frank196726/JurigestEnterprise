    private sealed class MateriaItem { public Guid Id { get; set; } public string Nombre { get; set; } = string.Empty; }
    private async Task AgregarMateriaAsync()
    {
        if (_guardandoCatalogo) return;
        if (string.IsNullOrWhiteSpace(_nuevaMateria)) { _mensajeGestion = "Ingrese el nombre de la materia."; return; }
        _guardandoCatalogo = true;
        try
        {
            using var respuesta = await ApiClient.PostAsync("/api/Catalogos/materias", JsonContent.Create(new { nombre = _nuevaMateria.Trim() }));
            if (!respuesta.IsSuccessStatusCode) throw new InvalidOperationException(await respuesta.Content.ReadAsStringAsync());
            var creada = await respuesta.Content.ReadFromJsonAsync<MateriaItem>();
            if (creada is null) throw new InvalidOperationException("No se recibió la materia creada.");
            _materias.Add(creada); _nuevaGestion.MateriaId = creada.Id;
            _nuevaMateria = string.Empty; _mostrarMateria = false;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _mensajeGestion = ex.Message; }
        finally { _guardandoCatalogo = false; }
    }

