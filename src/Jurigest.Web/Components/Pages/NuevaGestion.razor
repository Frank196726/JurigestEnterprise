    private async Task GuardarGestionAsync()
    {
        _guardandoGestion =
            true;

        _gestionGuardada =
            false;

        _mensajeGestion =
            null;

        Guid? causaId =
            null;

        try
        {
            if (!ResolverCatalogosSeleccionados())
            {
                return;
            }

            var diligenciaCatalogo =
                ObtenerDiligenciaEncargadaSeleccionada();

            if (diligenciaCatalogo?.CodigoTipoDiligencia
                is not int codigoTipo)
            {
                _mensajeGestion =
                    "La diligencia encargada seleccionada no tiene " +
                    "un tipo de diligencia asociado.";

                return;
            }

            var ritResultante =
                ObtenerRitResultante();

            if (string.IsNullOrWhiteSpace(
                    ritResultante))
            {
                _mensajeGestion =
                    "No fue posible construir el ROL.";

                return;
            }

            if (ritResultante.Length > 30)
            {
                _mensajeGestion =
                    "El ROL completo no puede superar 30 caracteres.";

                return;
            }

            var caratula =
                $"{_nuevaGestion.Demandante.Trim()} / " +
                $"{_nuevaGestion.DemandadoCaratula.Trim()}";

            using var respuestaCausa =
                await ApiClient.PostAsync(
                    "/api/Causas",
                    JsonContent.Create(
                        new
                        {
                            id =
                                Guid.Empty,

                            tipoCausaId =
                                _nuevaGestion.TipoCausaId,

                            numeroRol =
                                _nuevaGestion.NumeroRol
                                    .Trim(),

                            tribunal =
                                _nuevaGestion.Tribunal,

                            descripcion =
                                caratula,

                            demandados = new[]
                            {
                                new
                                {
                                    nombre = _nuevaGestion.Demandado.Trim(),
                                    tipoPersona = _nuevaGestion.TipoPersonaDemandado,
                                    esPrincipal = true,
                                    rut = _nuevaGestion.RutDemandado.Trim(),
                                    representanteLegal = _nuevaGestion.TipoPersonaDemandado == 2 ? _nuevaGestion.RepresentanteLegalDemandado.Trim() : null,
                                    rutRepresentanteLegal = _nuevaGestion.TipoPersonaDemandado == 2 ? _nuevaGestion.RutRepresentanteLegalDemandado.Trim() : null,
                                    avales = _nuevaGestion.AvalesSolidarios.Select(a => new {
                                        nombre = a.Nombre.Trim(), tipoPersona = a.TipoPersona, rut = a.Rut.Trim(),
                                        representanteLegal = a.TipoPersona == 2 ? a.RepresentanteLegal.Trim() : null,
                                        rutRepresentanteLegal = a.TipoPersona == 2 ? a.RutRepresentanteLegal.Trim() : null
                                    }).ToArray()
                                }
                            }.Concat(_nuevaGestion.OtrosDemandados.Select(d => new
                            {
                                nombre = d.Nombre.Trim(),
                                tipoPersona = d.TipoPersona,
                                esPrincipal = false,
                                rut = d.Rut.Trim(),
                                representanteLegal = d.TipoPersona == 2 ? d.RepresentanteLegal.Trim() : null,
                                rutRepresentanteLegal = d.TipoPersona == 2 ? d.RutRepresentanteLegal.Trim() : null,
                                avales = _nuevaGestion.AvalesSolidarios.Take(0).Select(a => new {
                                    nombre = a.Nombre.Trim(), tipoPersona = a.TipoPersona, rut = a.Rut.Trim(),
                                    representanteLegal = a.TipoPersona == 2 ? a.RepresentanteLegal.Trim() : null,
                                    rutRepresentanteLegal = a.TipoPersona == 2 ? a.RutRepresentanteLegal.Trim() : null
                                }).ToArray()
                            })).ToArray(),

                            materiaId = _nuevaGestion.MateriaId,
                            fechaEncargoCausa =
                                _nuevaGestion
                                    .FechaEncargoCausa!
                                    .Value
                                    .Date
                        }));

            await VerificarRespuestaAsync(
                respuestaCausa,
                "crear la causa");

            var causaCreada =
                await respuestaCausa.Content
                    .ReadFromJsonAsync<
                        CausaCreadaResponse>();

            causaId =
                causaCreada?.Id
                ?? throw new InvalidOperationException(
                    "La API no devolvió el identificador de la causa.");

            using var respuestaDiligencia =
                await ApiClient.PostAsync(
                    $"/api/Causas/{causaId}/diligencias",
                    JsonContent.Create(
                        new
                        {
                            descripcion =
                                _nuevaGestion.Diligencia,
                            tipo =
                                codigoTipo}));

            await VerificarRespuestaAsync(
                respuestaDiligencia,
                "crear la diligencia");

            var diligenciaCreada =
                await respuestaDiligencia.Content
                    .ReadFromJsonAsync<
                        DiligenciaCreadaResponse>();

            var diligenciaId =
                diligenciaCreada?.Id
                ?? throw new InvalidOperationException(
                    "La API no devolvió el identificador de la diligencia.");


            using var respuestaProgramacion =
                await ApiClient.PutAsync(
                    $"/api/Diligencias/{diligenciaId}/programar",
                    JsonContent.Create(
                        new
                        {
                            fechaProgramada =
                                _nuevaGestion
                                    .FechaProgramada!
                                    .Value
                                    .Date
                        }));

            await VerificarRespuestaAsync(
                respuestaProgramacion,
                "programar la diligencia");

            using var respuestaUbicacion =
                await ApiClient.PutAsync(
                    $"/api/Diligencias/{diligenciaId}/ubicacion",
                    JsonContent.Create(
                        new
                        {
                            direccion =
                                _nuevaGestion.Direccion.Trim(),
                            comuna =
                                _nuevaGestion.Comuna.Trim()
                        }));

            await VerificarRespuestaAsync(
                respuestaUbicacion,
                "registrar la ubicación de la diligencia");


            var retiro =
                _nuevaGestion.FechaRetiro.HasValue
                    ? _nuevaGestion.FechaRetiro
                        .Value
                        .ToString("dd-MM-yyyy")
                    : "No indicada";

            using var respuestaObservacion =
                await ApiClient.PutAsync(
                    $"/api/Diligencias/{diligenciaId}/observacion",
                    JsonContent.Create(
                        new
                        {
                            observacion =
                                $"Abogado responsable: " +
                                $"{_nuevaGestion.Abogado}. " +
                                $"Fecha de retiro: {retiro}." +
                                (string.IsNullOrWhiteSpace(_observaciones) ? string.Empty : $"\nObservaciones: {_observaciones.Trim()}")
                        }));

            await VerificarRespuestaAsync(
                respuestaObservacion,
                "registrar los datos del encargo");

            foreach (var vehiculo in _vehiculosGestion)
            {
                using var respuestaVehiculo = await ApiClient.PostAsync($"/api/diligencias/{diligenciaId}/vehiculos", JsonContent.Create(vehiculo));
                await VerificarRespuestaAsync(respuestaVehiculo, "guardar el vehículo");
            }
            _vehiculosGestion.Clear();
            _gestionGuardada =
                true;

            _mensajeGestion =
                $"La gestión {ritResultante} fue guardada " +
                "correctamente en Jurigest Enterprise.";

            _observaciones = string.Empty;
            _nuevaGestion =
                CrearModeloGestion();

            SeleccionarValoresIniciales();

            _nuevaGestion.DiligenciaEncargadaId =
                null;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException
                  or ArgumentException)
        {
            _mensajeGestion =
                causaId.HasValue
                    ? "La causa fue creada, pero la gestión " +
                      $"quedó incompleta: {ex.Message}"
                    : "No fue posible guardar la gestión: " +
                      ex.Message;
        }
        finally
        {
            _guardandoGestion =
                false;
        }
    }

    private bool ResolverCatalogosSeleccionados()
    {
        if (!_nuevaGestion.TipoCausaId.HasValue)
        {
            _mensajeGestion =
                "Debe seleccionar un tipo de causa.";

            return false;
        }

        if (string.IsNullOrWhiteSpace(
                _nuevaGestion.NumeroRol))
        {
            _mensajeGestion =
                "Debe indicar el número de ROL.";

            return false;
        }

        if (!_nuevaGestion.TribunalId.HasValue)
        {
            _mensajeGestion =
                "Debe seleccionar un tribunal.";

            return false;
        }

        if (!_nuevaGestion.AbogadoId.HasValue)
        {
            _mensajeGestion =
                "Debe seleccionar un abogado responsable.";

            return false;
        }

        if (!_nuevaGestion.DiligenciaEncargadaId.HasValue)
        {
            _mensajeGestion =
                "Debe seleccionar la diligencia encargada.";

            return false;
        }

        var tribunal =
            _tribunales.FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion.TribunalId.Value);

        var abogado =
            _abogados.FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion.AbogadoId.Value);

        var diligencia =
            _diligenciasEncargadas.FirstOrDefault(
                x =>
                    x.Id ==
                    _nuevaGestion.DiligenciaEncargadaId.Value);

        if (tribunal is null)
        {
            _mensajeGestion =
                "El tribunal seleccionado no está disponible.";

            return false;
        }

        if (abogado is null)
        {
            _mensajeGestion =
                "El abogado seleccionado no está disponible.";

            return false;
        }

        if (diligencia is null)
        {
            _mensajeGestion =
                "La diligencia seleccionada no está disponible.";

            return false;
        }

        _nuevaGestion.Tribunal =
            tribunal.Nombre.Trim();

        _nuevaGestion.Abogado =
            abogado.Nombre.Trim();

        _nuevaGestion.Diligencia =
            diligencia.Nombre.Trim();

        return true;
    }

