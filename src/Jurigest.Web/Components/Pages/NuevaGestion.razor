@using Jurigest.Domain.Judicial
@page "/causas/nueva"

@rendermode InteractiveServer
@attribute [Authorize(Policy = "CausasEscritura")]

@using System.Net.Http.Json
@using Jurigest.Web.Models
@using Jurigest.Web.Components.Shared
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Nueva gestión | Jurigest Enterprise</PageTitle>

<section class="causes-page reference-layout">

    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>

            <h1>Nueva gestión</h1>

            <p>
                Registra una causa y su primera diligencia.
            </p>
        </div>
    </header>


    <AuthorizeView Policy="CausasEscritura">
        <Authorized Context="usuarioAutorizado">

            <div class="history-card">
                <h2>Historial de gestiones · @ObtenerRitResultante()</h2>
                <div class="history-scroll">
                    <table><thead><tr><th>Gestión encargada</th><th>Fecha encargo</th><th>Fecha ejecución</th><th>Resultado</th><th>Observaciones</th></tr></thead>
                        <tbody><tr><td colspan="5">Nueva causa: su primera gestión se registrará al guardar.</td></tr></tbody>
                    </table>
                </div>
            </div>

            <aside class="gestion-sidebar" aria-label="Búsqueda y seguimiento">
                <section class="sidebar-card">
                    <h2>Búsqueda rápida por ROL</h2>
                    <form @onsubmit="BuscarRol" @onsubmit:preventDefault>
                        <label for="busqueda-gestion">Número ROL</label>
                        <input id="busqueda-gestion" class="form-control" @bind="_rolBusqueda" placeholder="Ej.: C-1505-26" required />
                        <button type="submit" class="btn btn-primary">Buscar</button>
                    </form>
                </section>
                <section class="sidebar-card">
                    <h2>Causas encargadas</h2>
                    @if (_panelGestion is null) { <p>Resumen no disponible.</p> }
                    else
                    {
                        <p>0–10 días sin gestionar <strong>@_panelGestion.CausasPorAntiguedad.Hasta10Dias</strong></p>
                        <p>11–15 días sin gestionar <strong>@_panelGestion.CausasPorAntiguedad.Entre11Y15Dias</strong></p>
                        <p>Más de 15 días <strong>@_panelGestion.CausasPorAntiguedad.MasDe15Dias</strong></p>
                    }
                    <a href="/causas">Ver causas</a>
                </section>
                <section class="sidebar-card">
                    <h2>Plazos de diligencias</h2>
                    @if (_panelGestion is null) { <p>Resumen no disponible.</p> }
                    else
                    {
                        <p>Vencidas <strong>@_panelGestion.DiligenciasPorPlazo.Vencidas</strong></p>
                        <p>Vencen hoy <strong>@_panelGestion.DiligenciasPorPlazo.VencenHoy</strong></p>
                        <p>Próximos 3 días <strong>@_panelGestion.DiligenciasPorPlazo.Proximos3Dias</strong></p>
                    }
                    <a href="/vencimientos">Ver vencimientos</a>
                </section>
            </aside>

            <section class="management-card"
                     aria-labelledby="titulo-nueva-gestion">

                <div class="management-heading">
                    <div>
                        <span class="eyebrow">
                            Nuevo registro
                        </span>

                        <h2 id="titulo-nueva-gestion">
                            Gestión actual: Nueva gestión
                        </h2>

                        <p>
                            Registra la causa y su primera diligencia
                            en Jurigest Enterprise.
                        </p>
                    </div>
                </div>

                <EditForm Model="_nuevaGestion"
                          OnValidSubmit="GuardarGestionAsync"
                          FormName="guardar-gestion">

                    <DataAnnotationsValidator />

                    <ValidationSummary
                        class="validation-summary" />

                    <div class="form-grid main-fields">

                        @* ==================================================
                           TIPO DE CAUSA
                           ================================================== *@

                        <div>
                            <label>
                                <span>Tipo de causa *</span>

                                <InputSelect
                                    @bind-Value="_nuevaGestion.TipoCausaId">

                                    <option value="">
                                        Seleccione...
                                    </option>

                                    @foreach (var tipo in _tiposCausa)
                                    {
                                        <option value="@tipo.Id">
                                            @tipo.Nombre - @tipo.Codigo
                                        </option>
                                    }

                                </InputSelect>
                            </label>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.TipoCausaId)" />

                            <button type="button"
                                    class="btn btn-secondary"
                                    style="margin-top:.5rem;"
                                    disabled="@_guardandoCatalogo"
                                    @onclick="AlternarAgregarTipoCausa">

                                @(_mostrarAgregarTipoCausa
                                    ? "Cancelar nuevo tipo"
                                    : "+ Agregar tipo de causa")

                            </button>
                        </div>

                        @* ==================================================
                           NÚMERO DE ROL
                           ================================================== *@

                        <div>
                            <label>
                                <span>Número ROL *</span>

                                <InputText
                                    @bind-Value="_nuevaGestion.NumeroRol"
                                    maxlength="30"
                                    placeholder="Ej.: 1188-26" />
                            </label>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.NumeroRol)" />
                        </div>

                        @if (_mostrarAgregarTipoCausa)
                        {
                            <div class="full-width catalog-editor">

                                <label>
                                    <span>Nombre del tipo de causa</span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="150"
                                           autocomplete="off"
                                           @bind="_nuevoTipoCausaNombre"
                                           placeholder="Ej.: Laboral" />
                                </label>

                                <label>
                                    <span>Código</span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="10"
                                           autocomplete="off"
                                           @bind="_nuevoTipoCausaCodigo"
                                           placeholder="Ej.: O" />
                                </label>

                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@_guardandoCatalogo"
                                        @onclick="AgregarTipoCausaAsync">
                                    Agregar
                                </button>

                            </div>
                        }

                        @* ==================================================
                           ROL RESULTANTE
                           ================================================== *@

                        @if (_nuevaGestion.TipoCausaId.HasValue &&
                             !string.IsNullOrWhiteSpace(
                                 _nuevaGestion.NumeroRol))
                        {
                            <div class="full-width rol-preview">

                                <span class="eyebrow">
                                    ROL resultante
                                </span>

                                <strong>
                                    @ObtenerRitResultante()
                                </strong>

                            </div>
                        }

                        @* ==================================================
                           TRIBUNAL
                           ================================================== *@

                        <div>
                            <label>
                                <span>Tribunal *</span>

                                <InputSelect
                                    @bind-Value="_nuevaGestion.TribunalId">

                                    <option value="">
                                        Seleccione...
                                    </option>

                                    @foreach (var tribunal in _tribunales)
                                    {
                                        <option value="@tribunal.Id">
                                            @tribunal.Nombre
                                        </option>
                                    }

                                </InputSelect>
                            </label>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.TribunalId)" />

                            <button type="button"
                                    class="btn btn-secondary"
                                    style="margin-top:.5rem;"
                                    disabled="@_guardandoCatalogo"
                                    @onclick="AlternarAgregarTribunal">

                                @(_mostrarAgregarTribunal
                                    ? "Cancelar nuevo tribunal"
                                    : "+ Agregar tribunal")

                            </button>
                        </div>

                        @* ==================================================
                           ABOGADO
                           ================================================== *@

                        <div>
                            <label>
                                <span>Abogado responsable *</span>

                                <InputSelect
                                    @bind-Value="_nuevaGestion.AbogadoId"
                                    @bind-Value:after="AsociarDemandanteConAbogado">

                                    <option value="">
                                        Seleccione...
                                    </option>

                                    @foreach (var abogado in _abogados)
                                    {
                                        <option value="@abogado.Id">
                                            @abogado.Nombre
                                        </option>
                                    }

                                </InputSelect>
                            </label>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.AbogadoId)" />

                            <button type="button"
                                    class="btn btn-secondary"
                                    style="margin-top:.5rem;"
                                    disabled="@_guardandoCatalogo"
                                    @onclick="AlternarAgregarAbogado">

                                @(_mostrarAgregarAbogado
                                    ? "Cancelar nuevo abogado"
                                    : "+ Agregar abogado")

                            </button>


                        </div>

                        @if (_mostrarAgregarTribunal)
                        {
                            <div class="full-width catalog-editor single">

                                <label>
                                    <span>Nombre del tribunal</span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="200"
                                           autocomplete="off"
                                           @bind="_nuevoTribunal"
                                           placeholder="Ej.: 10° Juzgado Civil de Santiago" />
                                </label>

                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@_guardandoCatalogo"
                                        @onclick="AgregarTribunalAsync">
                                    Agregar tribunal
                                </button>

                            </div>
                        }

                        @if (_mostrarAgregarAbogado)
                        {
                            <div class="full-width catalog-editor single">

                                <label>
                                    <span>Nombre del abogado</span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="200"
                                           autocomplete="off"
                                           @bind="_nuevoAbogado"
                                           placeholder="Nombre completo" />
                                </label>

                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@_guardandoCatalogo"
                                        @onclick="AgregarAbogadoAsync">
                                    Agregar abogado
                                </button>

                            </div>
                        }

                        <fieldset class="full-width caratula-box">
                            <legend>Carátula</legend>
                            <div class="caratula-fields">
                                <label><span>Demandante asociado al abogado *</span><InputText @bind-Value="_nuevaGestion.Demandante" maxlength="200" /><ValidationMessage For="@(() => _nuevaGestion.Demandante)" /></label>
                                <span class="caratula-con">con</span>
                                <label><span>Demandado — primer apellido y primer nombre *</span><InputText @bind-Value="_nuevaGestion.DemandadoCaratula" maxlength="200" placeholder="Ej.: Maldonado Julio" /><ValidationMessage For="@(() => _nuevaGestion.DemandadoCaratula)" /><small>Ingrese el primer apellido y el primer nombre. El nombre completo se registra por separado en los antecedentes del demandado.</small></label>
                            </div>
                        </fieldset>
                        @* ==================================================
                           PARTES
                           ================================================== *@

                        @* ==================================================
                           FECHAS
                           ================================================== *@

                        <label>
                            <span>Fecha de encargo de la causa *</span>

                            <InputDate
                                @bind-Value="_nuevaGestion.FechaEncargoCausa" />
                            <button type="button" class="btn btn-secondary" @onclick="() => _nuevaGestion.FechaEncargoCausa = DateTime.Today">Hoy</button>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.FechaEncargoCausa)" />
                        </label>

                        <label>
                            <span>Fecha de retiro</span>

                            <InputDate
                                @bind-Value="_nuevaGestion.FechaRetiro" />
                            <button type="button" class="btn btn-secondary" @onclick="() => _nuevaGestion.FechaRetiro = DateTime.Today">Hoy</button>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.FechaRetiro)" />
                        </label>

                        @* ==================================================
                           DILIGENCIA ENCARGADA
                           ================================================== *@

                        <label>
                            <span>Fecha programada *</span>

                            <InputDate
                                 @bind-Value="_nuevaGestion.FechaProgramada" />

                            <ValidationMessage
                                For="@(() => _nuevaGestion.FechaProgramada)" />
                        </label>

                        <div class="full-width">

                            <label>
                                <span>Diligencia encargada *</span>

                                <InputSelect
                                    @bind-Value="_nuevaGestion.DiligenciaEncargadaId">

                                    <option value="">
                                        Seleccione...
                                    </option>

                                    @foreach (var diligencia in
                                        _diligenciasEncargadas)
                                    {
                                        <option value="@diligencia.Id">
                                            @diligencia.Nombre
                                        </option>
                                    }

                                </InputSelect>
                            </label>

                            <ValidationMessage
                                For="@(() =>
                                    _nuevaGestion.DiligenciaEncargadaId)" />
                            <label class="mt-3"><span>Materia del juicio *</span>
                                <InputSelect @bind-Value="_nuevaGestion.MateriaId">
                                    <option value="">Seleccione...</option>
                                    @foreach (var materia in _materias) { <option value="@materia.Id">@materia.Nombre</option> }
                                </InputSelect>
                            </label>
                            <ValidationMessage For="@(() => _nuevaGestion.MateriaId)" />
                            <button type="button" class="btn btn-secondary mt-2" @onclick="() => _mostrarMateria = !_mostrarMateria">+ Agregar materia</button>
                            @if (_mostrarMateria)
                            {
                                <div class="border rounded p-3 mt-2">
                                    <input class="form-control" placeholder="Nombre de la materia" maxlength="200" @bind="_nuevaMateria" />
                                    <button type="button" class="btn btn-primary mt-2" disabled="@_guardandoCatalogo" @onclick="AgregarMateriaAsync">Agregar y seleccionar</button>
                                </div>
                            }


                            <button type="button"
                                    class="btn btn-secondary"
                                    style="margin-top:.5rem;"
                                    disabled="@_guardandoCatalogo"
                                    @onclick="AlternarAgregarDiligencia">

                                @(_mostrarAgregarDiligencia
                                    ? "Cancelar nueva diligencia"
                                    : "+ Agregar diligencia")

                            </button>

                        </div>

                        @if (_mostrarAgregarDiligencia)
                        {
                            <div class="full-width catalog-editor">

                                <label>
                                    <span>
                                        Nombre de la diligencia encargada
                                    </span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="200"
                                           autocomplete="off"
                                           @bind="_nuevaDiligencia"
                                           placeholder="Ej.: Notificación de demanda" />
                                </label>

                                <label>
                                    <span>Tipo de diligencia *</span>

                                    <select class="form-control"
                                            @bind="_nuevoCodigoTipoDiligencia">

                                        <option value="">
                                            Seleccione...
                                        </option>

                                        @foreach (var tipo in
                                            _tiposDiligencia)
                                        {
                                            if (tipo.CodigoSistema.HasValue)
                                            {
                                                <option
                                                    value="@tipo.CodigoSistema.Value">

                                                    @tipo.Nombre

                                                </option>
                                            }
                                        }

                                    </select>
                                </label>

                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@_guardandoCatalogo"
                                        @onclick="AgregarDiligenciaAsync">
                                    Agregar diligencia
                                </button>

                            </div>
                        }

                        <label class="full-width observations-field">
                            <span>Observaciones</span>
                            <textarea class="form-control" rows="4" maxlength="2000" @bind="_observaciones" placeholder="Información adicional de la diligencia..."></textarea>
                        </label>
                        <div class="full-width d-flex gap-2 mb-2">
                            <button type="button" class="btn btn-secondary" disabled="@_cargandoMembrete" @onclick="() => AbrirMembreteAsync()">Imprimir membrete</button>
                            <button type="button" class="btn btn-secondary" disabled="@_cargandoMembrete" @onclick="AbrirVehiculosAsync">Gestionar vehículos</button>
                        </div>
                        <section class="full-width" aria-labelledby="antecedentes-demandado" style="border:1px solid #dbe3ef;border-radius:.75rem;padding:1rem;">
                            <h3 id="antecedentes-demandado">Antecedentes del demandado</h3>
                            <div class="form-grid main-fields">
                        <label>
                            <span>Nombre / Razón Social *</span>

                            <InputText
                                @bind-Value="_nuevaGestion.Demandado"
                                placeholder="Nombre completo o razón social"
                                maxlength="200" />

                            <ValidationMessage
                                For="@(() => _nuevaGestion.Demandado)" />
                        </label>

                        <label>
                            <span>Tipo de persona del demandado principal *</span>
                            <InputSelect @bind-Value="_nuevaGestion.TipoPersonaDemandado">
                                <option value="1">Persona natural</option>
                                <option value="2">Persona jurídica / razón social</option>
                            </InputSelect>
                        </label>

                        <label>
                            <span>RUT del demandado principal *</span>
                            <InputText @bind-Value="_nuevaGestion.RutDemandado" maxlength="12" placeholder="12.345.678-5" />
                            <ValidationMessage For="@(() => _nuevaGestion.RutDemandado)" />
                        </label>
                        @if (_nuevaGestion.TipoPersonaDemandado == 2)
                        {
                            <label><span>Representante legal</span><InputText @bind-Value="_nuevaGestion.RepresentanteLegalDemandado" maxlength="200" /></label>
                            <label><span>RUT del representante legal</span><InputText @bind-Value="_nuevaGestion.RutRepresentanteLegalDemandado" maxlength="12" placeholder="12.345.678-5" /></label>
                        }

                        <label>
                            <span>Dirección *</span>

                            <InputText
                                @bind-Value="_nuevaGestion.Direccion"
                                maxlength="300"
                                placeholder="Dirección donde se practicará la diligencia" />

                            <ValidationMessage
                                For="@(() => _nuevaGestion.Direccion)" />
                        </label>

                        <div>

                            <label>

                                <span>Comuna *</span>

                            <InputSelect
                                @bind-Value="_nuevaGestion.Comuna">

                                <option value="">
                                    Seleccione...
                                </option>

                                @foreach (var comuna in _comunas)
                                {
                                    <option value="@comuna.Nombre">
                                        @comuna.Nombre
                                    </option>
                                }


                            </InputSelect>

                            <ValidationMessage
                                For="@(() => _nuevaGestion.Comuna)" />
                        </label>

                        <button type="button"
                                class="btn btn-secondary"
                                style="margin-top:.5rem;"
                                disabled="@_guardandoCatalogo"
                                @onclick="AlternarAgregarComuna">
                            @(_mostrarAgregarComuna
                                ? "Cancelar nueva comuna"
                                : "+ Agregar comuna")
                        </button>
                    </div>

                        @if (_mostrarAgregarComuna)
                        {
                            <div class="full-width catalog-editor single">
                                <label>
                                    <span>Nombre de la comuna</span>

                                    <input type="text"
                                           class="form-control"
                                           maxlength="150"
                                           autocomplete="off"
                                           @bind="_nuevaComuna"
                                           placeholder="Ej.: Providencia" />
                                </label>

                                <button type="button"
                                        class="btn btn-primary"
                                        disabled="@_guardandoCatalogo"
                                        @onclick="AgregarComunaAsync">
                                    Agregar comuna
                                </button>
                            </div>
                        }


                            </div>
                        </section>

                        <div class="full-width">
                            <h3>Avales solidarios del demandado principal</h3>
                            @foreach (var aval in _nuevaGestion.AvalesSolidarios)
                            {
                                <div class="form-grid" @key="aval">
                                    <label><span>Nombre o razón social</span><InputText @bind-Value="aval.Nombre" maxlength="200" /></label>
                                    <label><span>Tipo de persona</span><InputSelect @bind-Value="aval.TipoPersona"><option value="1">Persona natural</option><option value="2">Persona jurídica</option></InputSelect></label>
                                    <label><span>RUT *</span><InputText @bind-Value="aval.Rut" maxlength="12" placeholder="12.345.678-5" /></label>
                                    @if (aval.TipoPersona == 2)
                                    {
                                        <label><span>Representante legal</span><InputText @bind-Value="aval.RepresentanteLegal" maxlength="200" /></label>
                                        <label><span>RUT del representante</span><InputText @bind-Value="aval.RutRepresentanteLegal" maxlength="12" /></label>
                                    }
                                    <button type="button" class="btn btn-secondary" @onclick="() => _nuevaGestion.AvalesSolidarios.Remove(aval)">Quitar aval</button>
                                </div>
                            }
                            <button type="button" class="btn btn-secondary" @onclick="() => _nuevaGestion.AvalesSolidarios.Add(new DemandadoGestionModel())">+ Agregar aval solidario</button>
                        </div>


                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        _mensajeGestion))
                    {
                        <div class="form-message @(
                            _gestionGuardada
                                ? "success"
                                : "error")"
                             role="status">

                            @_mensajeGestion

                        </div>
                    }

                    <div class="form-actions">

                        <button type="button"
                                class="btn btn-secondary"
                                disabled="@(
                                    _guardandoGestion ||
                                    _guardandoCatalogo)"
                                @onclick="Volver">
                            ← Volver
                        </button>

                        <button type="submit"
                                disabled="@(
                                    _guardandoGestion ||
                                    _guardandoCatalogo)">

                            @(_guardandoGestion
                                ? "Guardando..."
                                : "Guardar gestión")

                        </button>

                    </div>

                </EditForm>

            </section>

        </Authorized>
    </AuthorizeView>

</section>

@if (_mostrarMembrete)
{
    <MembreteDialog FechaEncargo="_nuevaGestion.FechaEncargoCausa" FechaProgramada="_nuevaGestion.FechaProgramada" Encargo="@(ObtenerDiligenciaEncargadaSeleccionada()?.Nombre ?? string.Empty)" Personas="_personasMembrete" Direcciones="_direccionesMembrete" Rol="@ObtenerRitResultante()"
        Tribunal="@(_tribunales.FirstOrDefault(x => x.Id == _nuevaGestion.TribunalId)?.Nombre ?? string.Empty)"
        Abogado="@(_abogados.FirstOrDefault(x => x.Id == _nuevaGestion.AbogadoId)?.Nombre ?? string.Empty)"
        Caratula="@($"{_nuevaGestion.Demandante} / {_nuevaGestion.DemandadoCaratula}")" Cerrar="() => _mostrarMembrete = false" />
}

@if (_mostrarVehiculos)
{
    <VehiculosDialog Caratula="@($"{_nuevaGestion.Demandante} / {_nuevaGestion.DemandadoCaratula}")" Vehiculos="_vehiculosGestion" Personas="_personasMembrete" Direcciones="_direccionesMembrete"
        Rol="@ObtenerRitResultante()" Tribunal="@(_tribunales.FirstOrDefault(x => x.Id == _nuevaGestion.TribunalId)?.Nombre ?? string.Empty)"
        Cerrar="() => _mostrarVehiculos = false" />
}

@code {
    private string _observaciones = string.Empty;
    private string _rolBusqueda = string.Empty;
    private PanelEjecutivoResumen? _panelGestion;

    private void BuscarRol()
    {
        if (!string.IsNullOrWhiteSpace(_rolBusqueda))
            Navigation.NavigateTo($"/causas/buscar?rit={Uri.EscapeDataString(_rolBusqueda.Trim())}");
    }

    [SupplyParameterFromQuery(Name = "rit")]
    public string? RitInicial { get; set; }

    // =========================================================
    // DATOS
    // =========================================================

    private readonly List<TipoCausaItem>
        _tiposCausa = [];

    private readonly List<CatalogoItem>
        _tribunales = [];

    private readonly List<CatalogoItem>
        _comunas = [];

    private readonly List<AbogadoItem>
        _abogados = [];

    private readonly List<DiligenciaEncargadaItem>
        _diligenciasEncargadas = [];

    private readonly List<TipoDiligenciaItem>
        _tiposDiligencia = [];

    private RegistrarGestionModel _nuevaGestion =
        CrearModeloGestion();

    // =========================================================
    // ESTADO GENERAL
    // =========================================================

    private string? _mensajeGestion;

    private bool _guardandoGestion;

    private bool _gestionGuardada;

    private bool _guardandoCatalogo;

    // =========================================================
    // FORMULARIOS DE CATÁLOGO
    // =========================================================

    private bool _mostrarAgregarTipoCausa;

    private bool _mostrarAgregarTribunal;


    private bool _mostrarAgregarComuna;
private bool _mostrarAgregarAbogado;

    private bool _mostrarAgregarDiligencia;

    private string _nuevoTipoCausaNombre =
        string.Empty;

    private string _nuevoTipoCausaCodigo =
        string.Empty;

    private string _nuevoTribunal =
        string.Empty;


    private string _nuevaComuna =
