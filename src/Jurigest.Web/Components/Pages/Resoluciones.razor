@page "/resoluciones"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Net
@using System.Net.Http.Json
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Resoluciones | Jurigest Enterprise</PageTitle>

<section class="resoluciones-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>
            <h1>Resoluciones</h1>
            <p>Consulta y registra las resoluciones asociadas a cada causa.</p>
        </div>
        <span class="count-badge">@_resoluciones.Count resoluciones</span>
    </header>

    <section class="toolbar">
        <label>
            <span>Seleccionar causa</span>
            <select value="@_causaSeleccionadaId" @onchange="CambiarCausaAsync">
                @foreach (var causa in _causas)
                {
                    <option value="@causa.Id">@causa.Rit — @causa.Tribunal</option>
                }
            </select>
        </label>
    </section>

    <AuthorizeView Roles="Administrador,Abogado,Procurador">
        <Authorized>
            <section class="form-card">
                <div>
                    <span class="eyebrow">Nueva resolución</span>
                    <h2>Registrar resolución</h2>
                </div>
                <div class="form-grid">
                    <label>
                        <span>Tipo</span>
                        <select @bind="_tipo">
                            <option value="1">Decreto</option>
                            <option value="2">Auto</option>
                            <option value="3">Sentencia interlocutoria</option>
                            <option value="4">Sentencia definitiva</option>
                            <option value="5">Oficio</option>
                            <option value="99">Otro</option>
                        </select>
                    </label>
                    <label>
                        <span>Fecha</span>
                        <input type="date" @bind="_fecha" />
                    </label>
                    <label class="description-field">
                        <span>Descripción</span>
                        <input type="text" maxlength="2000" placeholder="Detalle de la resolución" @bind="_descripcion" />
                    </label>
                    <button type="button" class="primary-button" disabled="@(_guardando || _causaSeleccionadaId == Guid.Empty || string.IsNullOrWhiteSpace(_descripcion))" @onclick="RegistrarAsync">
                        @(_guardando ? "Registrando…" : "Registrar")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="message success" role="status">@_mensaje</div>
                }
                @if (!string.IsNullOrWhiteSpace(_errorFormulario))
                {
                    <div class="message error" role="alert">@_errorFormulario</div>
                }
            </section>
        </Authorized>
    </AuthorizeView>

    @if (_cargando)
    {
        <div class="state-card"><p>Cargando resoluciones…</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorCarga))
    {
        <div class="state-card error"><strong>No fue posible cargar las resoluciones</strong><p>@_errorCarga</p></div>
    }
    else if (_causas.Count == 0)
    {
        <div class="state-card"><strong>No existen causas registradas</strong></div>
    }
    else if (_resoluciones.Count == 0)
    {
        <div class="state-card"><strong>La causa no tiene resoluciones</strong><p>Registra la primera resolución o selecciona otra causa.</p></div>
    }
    else
    {
        <div class="table-card">
            <table>
                <thead><tr><th>Fecha</th><th>Tipo</th><th>Descripción</th><AuthorizeView Roles="Administrador"><Authorized><th>Acciones</th></Authorized></AuthorizeView></tr></thead>
                <tbody>
                    @foreach (var resolucion in _resoluciones)
                    {
                        <tr @key="resolucion.Id">
                            <td>@resolucion.Fecha.ToString("dd-MM-yyyy")</td>
                            <td><span class="type-badge">@ObtenerTipo(resolucion.Tipo)</span></td>
                            <td>@resolucion.Descripcion</td>
                            <AuthorizeView Roles="Administrador">
                                <Authorized>
                                    <td><button type="button" class="delete-button" disabled="@(_eliminandoId == resolucion.Id)" @onclick="() => EliminarAsync(resolucion.Id)">@(_eliminandoId == resolucion.Id ? "Eliminando…" : "Eliminar")</button></td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private readonly List<CausaResumen> _causas = [];
    private readonly List<ResolucionResumen> _resoluciones = [];
    private Guid _causaSeleccionadaId;
    private Guid? _eliminandoId;
    private int _tipo = 1;
    private DateTime _fecha = DateTime.Today;
    private string _descripcion = string.Empty;
    private string? _mensaje;
    private string? _errorFormulario;
    private string? _errorCarga;
    private bool _cargando = true;
    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var causas = await ApiClient.GetAsync<List<CausaResumen>>("/api/Causas");
            if (causas is not null) _causas.AddRange(causas);
            if (_causas.Count > 0)
            {
                _causaSeleccionadaId = _causas[0].Id;
                await CargarResolucionesAsync();
            }
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _errorCarga = "El servicio no está disponible. Inténtalo nuevamente."; }
        finally { _cargando = false; }
    }

    private async Task CambiarCausaAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id)) return;
        _causaSeleccionadaId = id;
        _mensaje = null;
        _errorFormulario = null;
        _cargando = true;
        try { await CargarResolucionesAsync(); }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _errorCarga = "No fue posible cargar las resoluciones."; }
        finally { _cargando = false; }
    }

    private async Task CargarResolucionesAsync()
    {
        _errorCarga = null;
        _resoluciones.Clear();
        var resultado = await ApiClient.GetAsync<List<ResolucionResumen>>($"/api/Causas/{_causaSeleccionadaId}/resoluciones");
        if (resultado is not null) _resoluciones.AddRange(resultado.OrderByDescending(x => x.Fecha));
    }

    private async Task RegistrarAsync()
    {
        if (_guardando || string.IsNullOrWhiteSpace(_descripcion)) return;
        _guardando = true;
        _mensaje = null;
        _errorFormulario = null;
        try
        {
            using var contenido = JsonContent.Create(new { tipo = _tipo, fecha = _fecha, descripcion = _descripcion.Trim() });
            using var response = await ApiClient.PostAsync($"/api/Causas/{_causaSeleccionadaId}/resoluciones", contenido);
            if (!response.IsSuccessStatusCode)
            {
                _errorFormulario = response.StatusCode == HttpStatusCode.Forbidden ? "Su usuario no tiene permiso para registrar resoluciones." : await LeerErrorAsync(response, "No fue posible registrar la resolución.");
                return;
            }
            _descripcion = string.Empty;
            _tipo = 1;
            _fecha = DateTime.Today;
            _mensaje = "Resolución registrada correctamente.";
            await CargarResolucionesAsync();
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _errorFormulario = "No fue posible conectar con el servicio."; }
        finally { _guardando = false; }
    }

    private async Task EliminarAsync(Guid id)
    {
        if (_eliminandoId is not null) return;
        _eliminandoId = id;
        _mensaje = null;
        _errorFormulario = null;
        try
        {
            using var response = await ApiClient.DeleteAsync($"/api/Resoluciones/{id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorFormulario = response.StatusCode == HttpStatusCode.Forbidden ? "Su usuario no tiene permiso para eliminar resoluciones." : await LeerErrorAsync(response, "No fue posible eliminar la resolución.");
                return;
            }
            _mensaje = "Resolución eliminada correctamente.";
            await CargarResolucionesAsync();
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _errorFormulario = "No fue posible conectar con el servicio."; }
        finally { _eliminandoId = null; }
    }

    private static async Task<string> LeerErrorAsync(HttpResponseMessage response, string alternativo)
    {
        var error = await response.Content.ReadFromJsonAsync<MensajeResponse>();
        return error?.Mensaje ?? alternativo;
    }

    private static string ObtenerTipo(int tipo) => tipo switch { 1 => "Decreto", 2 => "Auto", 3 => "Sentencia interlocutoria", 4 => "Sentencia definitiva", 5 => "Oficio", 99 => "Otro", _ => "Sin tipo" };
    private sealed record MensajeResponse(string Mensaje);
}
