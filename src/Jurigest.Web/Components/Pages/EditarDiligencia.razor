@page "/diligencias/{DiligenciaId:guid}/editar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "DiligenciasGestion")]

@using System.Net.Http.Json
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationState

<PageTitle>Modificar diligencia | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>
            <h1>Modificar diligencia</h1>
            @if (_causa is not null)
            {
                <p>@_causa.Rit — @_causa.Tribunal</p>
            }
        </div>
    </header>

    @if (_cargando)
    {
        <div class="state-card"><p>Cargando diligencia...</p></div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeErrorCarga))
    {
        <div class="state-card error">
            <strong>No fue posible continuar</strong>
            <p>@_mensajeErrorCarga</p>
            <button type="button" class="btn btn-secondary" @onclick="Volver">← Volver</button>
        </div>
    }
    else if (_diligencia is not null)
    {
        <div class="table-card">
            <div style="padding:1.5rem;">
                <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-bottom:1rem;">
                    <div style="grid-column:1 / -1;">
                        <label for="descripcion-diligencia">Tipo de Diligencia *</label>
                        <div class="d-flex gap-2">
                        <select id="descripcion-diligencia" class="form-control" @bind="_descripcion">
                            <option value="">Seleccione el tipo de diligencia...</option>
                            @if (!string.IsNullOrWhiteSpace(_descripcion) && !_encargos.Any(x => x.Nombre == _descripcion))
                            {
                                <option value="@_descripcion">@_descripcion</option>
                            }
                            @foreach (var encargo in _encargos.OrderBy(x => x.Nombre))
                            {
                                <option value="@encargo.Nombre">@encargo.Nombre</option>
                            }
                        </select>
                            <button type="button" class="btn btn-secondary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="() => _mostrarAgregarEncargo = !_mostrarAgregarEncargo">+ Agregar diligencia</button>
                        </div>
                        @if (_mostrarAgregarEncargo)
                        {
                            <div class="border rounded p-3 mt-2">
                                <label for="nuevo-encargo">Nombre de la nueva diligencia</label>
                                <input id="nuevo-encargo" class="form-control mb-2" maxlength="200" @bind="_nuevoEncargo" disabled="@_guardandoCatalogo" />
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="AgregarEncargoAsync">@(_guardandoCatalogo ? "Agregando..." : "Agregar y seleccionar")</button>
                                    <button type="button" class="btn btn-secondary" disabled="@_guardandoCatalogo" @onclick="() => _mostrarAgregarEncargo = false">Cancelar</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div>
                        <label for="tipo-diligencia">Diligencia Encargada</label>
                        <div class="d-flex gap-2">
                            <select id="tipo-diligencia" class="form-control" @bind="_tipo">
                                @if (!_tiposDiligencia.Any(t => t.CodigoSistema == _tipo))
                                {
                                    <option value="@_tipo">Diligencia encargada actual (@_tipo)</option>
                                }
                                @foreach (var tipo in _tiposDiligencia.Where(t => t.CodigoSistema.HasValue))
                                {
                                    <option value="@tipo.CodigoSistema.GetValueOrDefault()">@tipo.Nombre</option>
                                }
                            </select>
                            <button type="button" class="btn btn-secondary" disabled="@(_guardando || _guardandoCatalogo)"
                                    @onclick="() => _mostrarAgregarTipo = !_mostrarAgregarTipo">+ Agregar diligencia</button>
                        </div>
                        @if (_mostrarAgregarTipo)
                        {
                            <div class="border rounded p-3 mt-2">
                                <label for="nuevo-tipo-diligencia">Nombre de la nueva diligencia encargada</label>
                                <input id="nuevo-tipo-diligencia" class="form-control mb-2" @bind="_nuevoTipo" disabled="@_guardandoCatalogo" />
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="AgregarTipoAsync">
                                        @(_guardandoCatalogo ? "Agregando..." : "Agregar y seleccionar")
                                    </button>
                                    <button type="button" class="btn btn-secondary" disabled="@_guardandoCatalogo" @onclick="() => _mostrarAgregarTipo = false">Cancelar</button>
                                </div>
                            </div>
                        }
                    </div>

                    <label>
                        <span>Fecha programada</span>
                        <input type="datetime-local" class="form-control" @bind="_fechaProgramada" />
                    </label>

                    <label style="grid-column:1 / -1;">
                        <span>Receptor judicial</span>
                        <input type="text" class="form-control" value="@_receptorJudicial" readonly />
                    </label>

                    <label>
                        <span>Dirección de Notificación</span>
                        <input type="text" class="form-control" @bind="_direccion" />
                    </label>

                    <div>
                        <label for="comuna-diligencia">Comuna</label>
                        <div class="d-flex gap-2">
                            <select id="comuna-diligencia" class="form-control" @bind="_comuna">
                                <option value="">Seleccionar comuna...</option>
                                @if (!string.IsNullOrWhiteSpace(_comuna) && !_comunas.Any(c => c.Nombre == _comuna))
                                {
                                    <option value="@_comuna">@_comuna</option>
                                }
                                @foreach (var comuna in _comunas.OrderBy(c => c.Nombre))
                                {
                                    <option value="@comuna.Nombre">@comuna.Nombre</option>
                                }
                            </select>
                            <button type="button" class="btn btn-secondary" disabled="@(_guardando || _guardandoCatalogo)"
                                    @onclick="() => _mostrarAgregarComuna = !_mostrarAgregarComuna">+ Agregar comuna</button>
                        </div>
                        @if (_mostrarAgregarComuna)
                        {
                            <div class="border rounded p-3 mt-2">
                                <label for="nueva-comuna">Nombre de la nueva comuna</label>
                                <input id="nueva-comuna" class="form-control mb-2" @bind="_nuevaComuna" disabled="@_guardandoCatalogo" />
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="AgregarComunaAsync">
                                        @(_guardandoCatalogo ? "Agregando..." : "Agregar y seleccionar")
                                    </button>
                                    <button type="button" class="btn btn-secondary" disabled="@_guardandoCatalogo" @onclick="() => _mostrarAgregarComuna = false">Cancelar</button>
                                </div>
                            </div>
                        }
                    </div>

                    <label style="grid-column:1 / -1;">
                        <span>Observaciones</span>
                        <textarea class="form-control" rows="4" @bind="_observaciones"></textarea>
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="alert alert-danger" style="margin-bottom:1rem;">@_mensaje</div>
                }

                <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
                    <button type="button" class="btn btn-primary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="GuardarAsync">
                        @(_guardando ? "Guardando..." : "Guardar cambios")
                    </button>
                    <button type="button" class="btn btn-secondary" disabled="@(_guardando || _guardandoCatalogo)" @onclick="Volver">
                        ← Volver
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid DiligenciaId { get; set; }

    private DiligenciaDetalle? _diligencia;
    private CausaResumen? _causa;
    private string _descripcion = string.Empty;
    private int _tipo = 99;
    private DateTime? _fechaProgramada;
    private string _receptorJudicial = string.Empty;
    private string _direccion = string.Empty;
    private string _comuna = string.Empty;
    private string _observaciones = string.Empty;
    private string? _mensaje;
    private string? _mensajeErrorCarga;
    private bool _cargando = true;
    private bool _guardando;
    private bool _guardandoCatalogo;
    private bool _mostrarAgregarTipo;
    private bool _mostrarAgregarComuna;
    private string _nuevaComuna = string.Empty;
    private List<ComunaItem> _comunas = new();
    private string _nuevoTipo = string.Empty;
    private List<TipoCatalogoItem> _tiposDiligencia = new();
    private List<EncargoItem> _encargos = new();
    private sealed record EncargoItem(Guid Id, string Nombre);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _diligencia = await ApiClient.GetAsync<DiligenciaDetalle>(
                $"/api/Diligencias/{DiligenciaId}");

            if (_diligencia is null)
            {
                _mensajeErrorCarga = "La diligencia indicada no existe.";
                return;
            }

            if (_diligencia.Estado != 1)
            {
                _mensajeErrorCarga = "Solo se puede modificar una diligencia pendiente.";
                return;
            }

            var causas = await ApiClient.GetAsync<List<CausaResumen>>("/api/Causas");
            _causa = causas?.FirstOrDefault(c => c.Id == _diligencia.CausaId);

            _descripcion = _diligencia.Descripcion;
            _encargos = await ApiClient.GetAsync<List<EncargoItem>>("/api/Catalogos/diligencias-encargadas") ?? new();
            _tipo = _diligencia.Tipo;
            _tiposDiligencia = await ApiClient.GetAsync<List<TipoCatalogoItem>>(
                "/api/Catalogos/tipos-diligencia") ?? new();
            _fechaProgramada = _diligencia.FechaProgramada;
            var estado = await AuthenticationState.GetAuthenticationStateAsync();
            _receptorJudicial = estado.User.Identity?.Name ?? string.Empty;
            if (string.IsNullOrWhiteSpace(_receptorJudicial))
            {
                _mensajeErrorCarga = "No fue posible obtener el nombre del receptor de la cuenta.";
                return;
            }
            _comunas = await ApiClient.GetAsync<List<ComunaItem>>("/api/Catalogos/comunas") ?? new();
            _direccion = _diligencia.Direccion ?? string.Empty;
            _comuna = _diligencia.Comuna ?? string.Empty;
            _observaciones = _diligencia.Observaciones ?? string.Empty;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeErrorCarga = "No fue posible comunicarse con Jurigest.API.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private bool _mostrarAgregarEncargo;
    private string _nuevoEncargo = string.Empty;
    private async Task AgregarEncargoAsync()
    {
        if (_guardandoCatalogo || _guardando) return;
        _mensaje = null;
        if (string.IsNullOrWhiteSpace(_nuevoEncargo))
        {
            _mensaje = "Debe indicar el nombre de la nueva diligencia.";
            return;
        }
        _guardandoCatalogo = true;
        try
        {
            using var respuesta = await ApiClient.PostAsync("/api/Catalogos/diligencias-encargadas",
                JsonContent.Create(new { nombre = _nuevoEncargo.Trim(), codigoTipoDiligencia = _tipo }));
            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadFromJsonAsync<ErrorCatalogo>();
                throw new InvalidOperationException(error?.Mensaje ?? "No fue posible agregar la diligencia.");
            }
            var creada = await respuesta.Content.ReadFromJsonAsync<EncargoItem>()
                ?? throw new InvalidOperationException("No se recibió la diligencia creada.");
            _encargos.Add(creada);
            _descripcion = creada.Nombre;
            _nuevoEncargo = string.Empty;
            _mostrarAgregarEncargo = false;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException) { _mensaje = ex.Message; }
        finally { _guardandoCatalogo = false; }
    }
    private sealed record ErrorCatalogo(string Mensaje);

    private async Task AgregarTipoAsync()
    {
        if (_guardandoCatalogo || _guardando) return;
        _mensaje = null;
        if (string.IsNullOrWhiteSpace(_nuevoTipo))
        {
            _mensaje = "Debe indicar el nombre del nuevo tipo de diligencia.";
            return;
        }

        _guardandoCatalogo = true;
        try
        {
            using var response = await ApiClient.PostAsync(
                "/api/Catalogos/tipos-diligencia",
                JsonContent.Create(new { nombre = _nuevoTipo.Trim() }));
            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"No fue posible agregar el tipo de diligencia. {detalle}");
            }

            var creado = await response.Content.ReadFromJsonAsync<TipoCatalogoItem>();
            if (creado?.CodigoSistema is not int codigo)
                throw new InvalidOperationException("No se recibió el código del nuevo tipo de diligencia.");

            _tiposDiligencia.Add(creado);
            _tipo = codigo;
            _nuevoTipo = string.Empty;
            _mostrarAgregarTipo = false;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            _mensaje = ex.Message;
        }
        finally
        {
            _guardandoCatalogo = false;
        }
    }

    private async Task AgregarComunaAsync()
    {
        if (_guardandoCatalogo || _guardando) return;
        _mensaje = null;
        if (string.IsNullOrWhiteSpace(_nuevaComuna))
        {
            _mensaje = "Debe indicar el nombre de la nueva comuna.";
            return;
        }
        _guardandoCatalogo = true;
        try
        {
            using var response = await ApiClient.PostAsync("/api/Catalogos/comunas",
                JsonContent.Create(new { nombre = _nuevaComuna.Trim() }));
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException($"No fue posible agregar la comuna. {await response.Content.ReadAsStringAsync()}");
            var creada = await response.Content.ReadFromJsonAsync<ComunaItem>();
            if (creada is null || string.IsNullOrWhiteSpace(creada.Nombre))
                throw new InvalidOperationException("No se recibió la nueva comuna.");
            _comunas.Add(creada);
            _comuna = creada.Nombre;
            _nuevaComuna = string.Empty;
            _mostrarAgregarComuna = false;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            _mensaje = ex.Message;
        }
        finally
        {
            _guardandoCatalogo = false;
        }
    }

    private sealed class ComunaItem
    {
        public string Nombre { get; set; } = string.Empty;
    }

    private sealed class TipoCatalogoItem
    {
        public string Nombre { get; set; } = string.Empty;
        public int? CodigoSistema { get; set; }
    }

    private async Task GuardarAsync()
    {
        _mensaje = null;

        if (string.IsNullOrWhiteSpace(_descripcion))
        {
            _mensaje = "Debe seleccionar el tipo de diligencia.";
            return;
        }

        if (_descripcion.Trim().Length > 500)
        {
            _mensaje = "El tipo de diligencia no puede superar 500 caracteres.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_direccion) != string.IsNullOrWhiteSpace(_comuna))
        {
            _mensaje = "Debe indicar dirección y comuna, o dejar ambos campos vacíos.";
            return;
        }

        _guardando = true;

        try
        {
            using var response = await ApiClient.PutAsync(
                $"/api/Diligencias/{DiligenciaId}",
                JsonContent.Create(new
                {
                    descripcion = _descripcion.Trim(),
                    tipo = _tipo,
                    fechaProgramada = _fechaProgramada,
                    receptorJudicial = TextoOpcional(_receptorJudicial),
                    direccion = TextoOpcional(_direccion),
                    comuna = TextoOpcional(_comuna),
                    observaciones = TextoOpcional(_observaciones)
                }));

            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                throw new InvalidOperationException(
                    $"No fue posible actualizar la diligencia. HTTP {(int)response.StatusCode}. {detalle}");
            }

            Volver();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        {
            _mensaje = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Volver()
    {
        var causaId = _diligencia?.CausaId ?? Guid.Empty;
        Navigation.NavigateTo(causaId == Guid.Empty
            ? "/diligencias"
            : $"/diligencias?causaId={causaId}");
    }

    private static string? TextoOpcional(string valor) =>
        string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private sealed class DiligenciaDetalle
    {
        public Guid Id { get; set; }
        public Guid CausaId { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public int Tipo { get; set; }
        public int Estado { get; set; }
        public DateTime? FechaProgramada { get; set; }
        public string? ReceptorJudicial { get; set; }
        public string? Direccion { get; set; }
        public string? Comuna { get; set; }
        public string? Observaciones { get; set; }
    }
}
