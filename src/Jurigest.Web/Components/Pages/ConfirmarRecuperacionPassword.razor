@page "/password/recuperacion/confirmar"
@layout RecoveryLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Restablecer contraseña | Jurigest Enterprise</PageTitle>

<section class="recovery-card">
    @if (_completado)
{
    <div class="status-icon status-success">✓</div>

    <h1>Contraseña actualizada</h1>

    <p class="intro">
        Tu contraseña fue restablecida correctamente.
        Las sesiones anteriores fueron cerradas por seguridad.
    </p>

    <a class="primary-action" href="/">
        Continuar
    </a>
}
else if (string.IsNullOrWhiteSpace(_token))
{
    <div class="status-icon status-error">!</div>

    <h1>Enlace no válido</h1>

    <p class="intro">
        El enlace de recuperación está incompleto.
        Solicita uno nuevo para continuar.
    </p>

    <a class="secondary-action" href="/">
        Volver al inicio
    </a>
}
    else
    {
        <span class="eyebrow">Seguridad de la cuenta</span>

        <h1>Crea una nueva contraseña</h1>

        <p class="intro">
            Debe contener entre 12 y 128 caracteres.
            Utiliza una contraseña única que no uses en otros servicios.
        </p>

        <EditForm Model="_model"
                  FormName="recuperar-password"
                  OnValidSubmit="ConfirmarAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="nueva-password">
                    Nueva contraseña
                </label>

                <InputText id="nueva-password"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           @bind-Value="_model.NuevaPassword" />

                <ValidationMessage For="() => _model.NuevaPassword" />
            </div>

            <div class="field">
                <label for="confirmar-password">
                    Confirmar contraseña
                </label>

                <InputText id="confirmar-password"
                           class="form-control"
                           type="password"
                           autocomplete="new-password"
                           @bind-Value="_model.ConfirmarPassword" />

                <ValidationMessage For="() => _model.ConfirmarPassword" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_mensajeError))
            {
                <div class="alert-error" role="alert">
                    @_mensajeError
                </div>
            }

            <button class="submit-button"
                    type="submit"
                    disabled="@_procesando">
                @if (_procesando)
                {
                    <span class="spinner"
                          aria-hidden="true"></span>
                    <span>Actualizando…</span>
                }
                else
                {
                    <span>Restablecer contraseña</span>
                }
            </button>
        </EditForm>

        <p class="security-note">
            Por seguridad, este enlace es de un solo uso
            y tiene una vigencia limitada.
        </p>
    }
</section>

@code {
    private readonly RecuperacionModel _model = new();

    private string? _token;
    private string? _mensajeError;
    private bool _procesando;
    private bool _completado;

protected override void OnInitialized()
{
    var uri =
        Navigation.ToAbsoluteUri(
            Navigation.Uri);

    var parametros =
        QueryHelpers.ParseQuery(
            uri.Query);

    if (parametros.TryGetValue(
            "token",
            out var valores))
    {
        _token =
            valores.FirstOrDefault()?.Trim();
    }
}

    private async Task ConfirmarAsync()
    {
        if (_procesando ||
            string.IsNullOrWhiteSpace(_token))
        {
            return;
        }

        _procesando = true;
        _mensajeError = null;

        try
        {
            var client =
                HttpClientFactory.CreateClient("JurigestApi");

            using var response =
                await client.PostAsJsonAsync(
                    "/api/seguridad/password/recuperacion/confirmar",
                    new
                    {
                        token = _token,
                        nuevaPassword = _model.NuevaPassword
                    });

            if (response.IsSuccessStatusCode)
            {
                _completado = true;
                _token = null;
                _model.NuevaPassword = string.Empty;
                _model.ConfirmarPassword = string.Empty;
                return;
            }

            var error =
                await response.Content
                    .ReadFromJsonAsync<MensajeResponse>();

            _mensajeError =
                error?.Mensaje ??
                "No fue posible restablecer la contraseña.";
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "No fue posible conectar con el servicio. " +
                "Inténtalo nuevamente.";
        }
        catch (TaskCanceledException)
        {
            _mensajeError =
                "La solicitud tardó demasiado. " +
                "Inténtalo nuevamente.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private sealed class RecuperacionModel
    {
        [Required(
            ErrorMessage = "Ingresa una nueva contraseña.")]
        [StringLength(
            128,
            MinimumLength = 12,
            ErrorMessage =
                "La contraseña debe contener entre 12 y 128 caracteres.")]
        public string NuevaPassword { get; set; } = string.Empty;

        [Required(
            ErrorMessage = "Confirma la nueva contraseña.")]
        [Compare(
            nameof(NuevaPassword),
            ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmarPassword { get; set; } = string.Empty;
    }

    private sealed record MensajeResponse(
        string Mensaje);
}