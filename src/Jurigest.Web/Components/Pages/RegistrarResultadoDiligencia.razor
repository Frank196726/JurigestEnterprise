@page "/causas/{CausaId:guid}/diligencias/registrar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "DiligenciasGestion")]

@using System.Net.Http.Json
@using Microsoft.JSInterop
@using Jurigest.Web.Models
@using Jurigest.Web.Security
@using Jurigest.Web.Services.Estampes
@using Jurigest.Domain.Judicial.Enums

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Registrar resultado | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">

    <header class="page-heading">
        <div>

             <span class="eyebrow">Gestión judicial</span>

            <h1>Registrar resultado de diligencia</h1>

            @if (_causa is not null)
            {
                <p>
                    @_causa.Rit — @_causa.Tribunal
                </p>
            }
        </div>
        <a class="btn btn-secondary" href="@($"/diligencias?causaId={CausaId}")">← Volver</a>
    </header>

    @if (_cargando)
    {
        <div class="state-card">
            <p>Cargando diligencia...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="state-card error">

            <strong>No fue posible continuar</strong>

            <p>@_mensajeError</p>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Volver">
                Volver
            </button>

        </div>
    }
    else if (_causa is not null &&
             _diligencia is not null)
    {
        <div class="table-card">

            <div style="padding:1.5rem;">

                <div style="margin-bottom:1.5rem;">

                    <span class="eyebrow">
                        Causa seleccionada
                    </span>

                    <h2 style="margin-top:.4rem;">
                        @_causa.Rit
                    </h2>

                    <p>
                        <strong>Tribunal:</strong>
                        @_causa.Tribunal
                    </p>

                    <p>
                        <strong>Carátula / descripción:</strong>
                        @_causa.Descripcion
                    </p>

                    <section aria-labelledby="antecedentes-demandado" style="border:1px solid #dbe3ef;border-radius:.75rem;padding:1rem;margin-top:1rem;">
                        <h3 id="antecedentes-demandado">Antecedentes del demandado</h3>
                        <p><strong>Nombre / Razón Social:</strong> @(DemandadoPrincipal?.Nombre ?? "No registrado")</p>
                        <p><strong>RUT:</strong> @(string.IsNullOrWhiteSpace(DemandadoPrincipal?.Rut) ? "No registrado" : DemandadoPrincipal.Rut)</p>
                        <p><strong>Dirección:</strong> @(string.IsNullOrWhiteSpace(_diligencia.Direccion) ? "No registrada" : _diligencia.Direccion)</p>
                        <p><strong>Comuna:</strong> @(string.IsNullOrWhiteSpace(_diligencia.Comuna) ? "No registrada" : _diligencia.Comuna)</p>
                    </section>

                </div>

                @if (_diligencia.Resultado != 0)
                {
                    <div class="alert alert-info">

                        <strong>
                            Esta diligencia ya tiene un resultado registrado.
                        </strong>

                        <p style="margin-top:.75rem;">
                            <strong>Clasificación:</strong>
                            @ObtenerNombreResultado(_diligencia.Resultado)
                        </p>

                        <p>
                            <strong>Resultado de la diligencia:</strong>

                            @(string.IsNullOrWhiteSpace(
                                _diligencia.ResultadoDetalle)
                                    ? "Sin detalle registrado"
                                    : _diligencia.ResultadoDetalle)
                        </p>

                        <p>
                            <strong>Fecha de gestión:</strong>

                            @(_diligencia.FechaGestion.HasValue
                                ? _diligencia.FechaGestion.Value
                                    .ToString("dd-MM-yyyy HH:mm")
                                : "No registrada")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(
                            _diligencia.Estampe))
                        {
                            <p>
                                <strong>Estampe registrado:</strong>
                            </p>

                            <div style="
                                white-space:pre-wrap;
                                border:1px solid #ddd;
                                border-radius:.5rem;
                                padding:1rem;
                                background:#fff;">

                                @_diligencia.Estampe

                            </div>
                            <button type="button" class="btn btn-primary mt-3" @onclick="ImprimirEstampeAsync">Imprimir estampe</button>
                        }

                    </div>
                }

                @if (_diligencia.Resultado != 0 &&
                     !_editandoResultado)
                {
                    <div style="
                        display:flex;
                        gap:.75rem;
                        margin-top:1.5rem;
                        flex-wrap:wrap;">

                        <button type="button"
                                class="btn btn-warning"
                                @onclick="HabilitarEdicionResultado">

                            Editar resultado

                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="Volver">

                            Volver

                        </button>

                    </div>
                }
                else
                {
                    <div class="result-workspace">
                        <section class="result-panel">
                            <div class="panel-heading">
                                <div><span class="eyebrow">Ingreso del resultado</span><h3>Gestión realizada</h3></div>
                                <span class="required-note">* Campos obligatorios</span>
                            </div>

                            <div class="result-group">
                                <label>
                                    <span>Diligencia realizada *</span>
                                    <select class="form-select" @bind="_diligenciaRealizadaId" @bind:after="SeleccionarGestion" disabled="@(_reciboExistente is not null)">
                                        <option value="">Seleccionar diligencia realizada...</option>
                                        @foreach (var item in _diligenciasRealizadas) { <option value="@item.Id">@item.Nombre</option> }
                                    </select>
                                </label>
                                <button type="button" class="inline-add" disabled="@_guardandoCatalogo"
                                        @onclick="() => _mostrarAgregarDiligencia = !_mostrarAgregarDiligencia">+ Agregar opción</button>
                                @if (_mostrarAgregarDiligencia)
                                {
                                    <div class="inline-editor">
                                        <input class="form-control" maxlength="200" placeholder="Nombre de la diligencia realizada" @bind="_nuevaDiligencia" />
                                        <button type="button" class="btn btn-primary" disabled="@_guardandoCatalogo" @onclick="AgregarDiligenciaRealizadaAsync">Agregar</button>
                                    </div>
                                }

                                @if (_diligenciaRealizadaId.HasValue)
                                {
                                    <label><span>Materia del estampe</span><input class="form-control" @bind="_materiaEstampe" /></label>
                                    <label><span>Valor de la gestión (CLP) *</span>
                                        <input class="form-control" type="number" min="0" max="999999999999999999" step="1" @bind="_monto" @bind:after="ActualizarMontoEstampe" disabled="@(_reciboExistente is not null)" />
                                    </label>
                                    <fieldset class="border rounded p-3 mt-2" disabled="@(_reciboExistente is not null)">
                                        <legend class="fs-6">Datos del recibo</legend>
                                        <label>
                                            <span>Abogado</span>
                                            <select class="form-select" @bind="_abogadoRecibo">
                                                <option value="">Seleccionar abogado...</option>
                                                @if (!string.IsNullOrWhiteSpace(_abogadoRecibo) && !_abogados.Any(a => a.Nombre == _abogadoRecibo))
                                                {
                                                    <option value="@_abogadoRecibo">@_abogadoRecibo (registrado)</option>
                                                }
                                                @foreach (var abogado in _abogados.OrderBy(a => a.Nombre))
                                                {
                                                    <option value="@abogado.Nombre">@abogado.Nombre</option>
                                                }
                                            </select>
                                        </label>
                                        <label><span>N° operación</span><input class="form-control" maxlength="100" @bind="_numeroOperacion" /></label>
                                        <label><span>Cuantía (CLP)</span><input class="form-control" type="number" min="0" step="1" @bind="_cuantiaRecibo" /></label>
                                        <label><span>Observación recibo</span><input class="form-control" maxlength="1000" @bind="_observacionRecibo" /></label>
                                        <h5 class="mt-3">Datos adicionales</h5>
                                        <label><span>Detalle</span><input class="form-control" maxlength="1000" @bind="_detalleAdicionales" /></label>
                                        <label><span>Total adicionales (CLP)</span><input class="form-control" type="number" min="0" step="1" @bind="_totalAdicionales" /></label>
                                        <p class="mt-2 mb-0"><strong>Total recibo: @TotalRecibo.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CL"))</strong></p>
                                    </fieldset>
                                    <small>El estampe conserva el valor de gestión. El recibo suma gestión y adicionales; si el total es 0, no se emite recibo.</small>
                                    @if (_reciboExistente is not null) { <p>Esta diligencia ya tiene un recibo emitido; su gestión y valor están protegidos. <a href="/recibos">Ver recibos</a></p> }
                                }
                                <label>
                                    <span>Clasificación *</span>
                                    <select class="form-control" @bind="_resultado" @bind:after="SeleccionarModeloRelacionado">
                                        <option value="">Seleccionar clasificación...</option>
                                        <option value="1">Positiva</option><option value="2">Negativa</option>
                                    </select>
                                </label>

                            </div>

                            <div class="execution-group">
                                <h4>Datos de ejecución</h4>
                                <label><span>Receptor judicial</span>
                                    <select class="form-control" @bind="_receptorJudicial">
                                        <option value="">Seleccionar receptor...</option>
                                        @foreach (var item in _receptores) { <option value="@item.Nombre">@item.Nombre</option> }
                                    </select>
                                </label>
                                <button type="button" class="inline-add" disabled="@_guardandoCatalogo"
                                        @onclick="() => _mostrarAgregarReceptor = !_mostrarAgregarReceptor">+ Agregar receptor</button>
                                @if (_mostrarAgregarReceptor)
                                {
                                    <div class="inline-editor">
                                        <input class="form-control" maxlength="200" placeholder="Nombre del receptor judicial" @bind="_nuevoReceptor" />
                                        <button type="button" class="btn btn-primary" disabled="@_guardandoCatalogo" @onclick="AgregarReceptorAsync">Agregar</button>
                                    </div>
                                }
                                <label><span>Fecha de gestión *</span><input type="datetime-local" class="form-control" @bind="_fechaGestion" /></label>
                            </div>

                            <button type="button" class="btn btn-outline-primary generate-button" disabled="@_guardando" @onclick="GenerarBorradorEstampe">
                                @(!string.IsNullOrWhiteSpace(_estampe) ? "Regenerar borrador" : "Generar borrador")
                            </button>
                        </section>

                        <section class="preview-panel">
                            <div class="panel-heading">
                                <div><span class="eyebrow">Vista previa</span><h3>Borrador del estampe</h3></div>
                                @if (!string.IsNullOrWhiteSpace(_estampe)) { <span class="draft-badge">Borrador generado</span> }
                            </div>
                            <div class="model-box">
                                <label><span>Modelo aplicado</span>
                                    <select class="form-control" @bind="_modeloEstampeId" @bind:after="CambiarModeloEstampe">
                                        <option value="">Formato predeterminado</option>
                                        @foreach (var modelo in ModelosAplicables) { <option value="@modelo.Id">@modelo.Nombre (@NombreResultadoModelo(modelo.Resultado))</option> }
                                    </select>
                                </label>
                                <small>Seleccione el modelo requerido para la gestión actual. Al cambiarlo se regenera el borrador.</small>
                                <a href="/configuracion/modelos-estampe">Administrar modelos</a>
                            </div>
                            <textarea class="form-control stamp-preview" rows="22" maxlength="8000" @bind="_estampe"
                                      placeholder="Complete los antecedentes y genere el borrador para revisarlo aquí."></textarea>
                            @if (!string.IsNullOrWhiteSpace(_estampe)) { <small>Puede corregir manualmente el texto antes de guardarlo.</small> }
                        </section>
                    </div>

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <div class="@(
            _guardado
                ? "alert alert-success"
                : "alert alert-danger")"
         style="margin-top:1rem;">

        @_mensaje

    </div>
}

<div class="result-actions">

    <button type="button"
            class="btn btn-primary"
            disabled="@(_guardando || string.IsNullOrWhiteSpace(_estampe))"
            @onclick="GuardarResultadoAsync">

        @(_guardando
            ? "Guardando resultado..."
            : "Guardar resultado y estampe")

    </button>

    <button type="button"
            class="btn btn-secondary"
            disabled="@_guardando"
            @onclick="CancelarEdicion">

        Cancelar

    </button>

</div>
                }

            </div>

        </div>
    }

</section>

@code {

    [Parameter]
    public Guid CausaId { get; set; }

    [SupplyParameterFromQuery(Name = "diligenciaId")]
    public Guid? DiligenciaSeleccionadaId { get; set; }

    private CausaResumen? _causa;

    private DemandadoResumen? DemandadoPrincipal =>
        _causa?.Demandados.FirstOrDefault(d => d.EsPrincipal);

    private DiligenciaResponse? _diligencia;

    private List<DiligenciaRealizadaItem> _diligenciasRealizadas =
    new();

    private List<CatalogoItem> _receptores = new();
    private List<ModeloEstampeItem> _modelosEstampe = new();
    private Guid? _modeloEstampeId;
    private string _receptorJudicial = string.Empty;
    private string _nuevoReceptor = string.Empty;
    private string _nuevaDiligencia = string.Empty;
    private bool _mostrarAgregarReceptor;
    private bool _mostrarAgregarDiligencia;
    private bool _guardandoCatalogo;

    private Guid? _diligenciaRealizadaId;

    private decimal? _monto;
    private string? _abogadoRecibo;
    private List<CatalogoItem> _abogados = new();
    private string _materiaEstampe = string.Empty;
    private string? _numeroOperacion;
    private decimal? _cuantiaRecibo;
    private string? _observacionRecibo;
    private string? _detalleAdicionales;
    private decimal _totalAdicionales;
    private decimal TotalRecibo => (_monto ?? 0m) + _totalAdicionales;
    private ReciboItem? _reciboExistente;
    private sealed record ReciboItem(Guid Id, decimal Monto, int Estado)
    {
        public decimal ValorGestion { get; init; }
        public decimal TotalAdicionales { get; init; }
        public decimal? Cuantia { get; init; }
        public string? Abogado { get; init; }
        public string? NumeroOperacion { get; init; }
        public string? Observacion { get; init; }
        public string? DetalleAdicionales { get; init; }
    }
    private int? _resultado;

    private DateTime? _fechaGestion =
        DateTime.Now;

    private string _estampe =
        string.Empty;

    private string? _mensaje;

    private string? _mensajeError;

    private bool _cargando = true;

    private bool _guardando;

    private bool _guardado;

    private bool _editandoResultado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarCausaAsync();

            if (_causa is null)
            {
                _mensajeError =
                    "La causa indicada no existe o ya no está disponible.";

                return;
            }

            await CargarUltimaDiligenciaAsync();

            if (_diligencia is null)
            {
                _mensajeError =
                    "La causa no tiene diligencias registradas.";

                return;
            }

            await CargarDiligenciasRealizadasAsync();
            _abogados = await ApiClient.GetAsync<List<CatalogoItem>>("/api/Catalogos/abogados") ?? new();
            await CargarReceptoresAsync();
            await CargarModelosEstampeAsync();
            _receptorJudicial = _diligencia.ReceptorJudicial ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(_receptorJudicial) &&
                !_receptores.Any(x => x.Nombre == _receptorJudicial))
            {
                _receptores.Insert(0, new CatalogoItem { Nombre = _receptorJudicial });
            }

            CargarResultadoExistente();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            _mensajeError =
                "No fue posible comunicarse con Jurigest.API. " +
                ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarCausaAsync()
    {
        _causa =
            await ApiClient.GetAsync<CausaResumen>(
                $"/api/Causas/{CausaId}");
        _materiaEstampe = _causa?.Materia ?? string.Empty;
    }

    private async Task CargarUltimaDiligenciaAsync()
    {
            _diligencia =
            await ApiClient.GetAsync<DiligenciaResponse>(
                DiligenciaSeleccionadaId.HasValue
                    ? $"/api/Diligencias/{DiligenciaSeleccionadaId.Value}"
                    : $"/api/Diligencias/causa/{CausaId}/ultima");
        if (_diligencia is not null && _diligencia.CausaId != CausaId)
            throw new HttpRequestException("La diligencia seleccionada no pertenece a esta causa.");
        if (_diligencia is not null && string.IsNullOrWhiteSpace(_abogadoRecibo))
        {
            const string prefijo = "Abogado responsable: ";
            var observaciones = _diligencia.Observaciones;
            if (observaciones?.StartsWith(prefijo, StringComparison.Ordinal) == true)
            {
                var fin = observaciones.IndexOf(". Fecha de retiro:", StringComparison.Ordinal);
                _abogadoRecibo = fin > prefijo.Length ? observaciones[prefijo.Length..fin] : null;
            }
        }
        _reciboExistente = _diligencia is not null && _diligencia.Resultado != 0
            ? await ApiClient.GetAsync<ReciboItem>($"/api/Recibos/diligencia/{_diligencia.Id}") : null;
    }

    private async Task CargarDiligenciasRealizadasAsync()
    {
        if (_diligencia is null)
    {
        _diligenciasRealizadas.Clear();
        return;
    }

    var resultado =
        await ApiClient.GetAsync<List<DiligenciaRealizadaItem>>(
            $"/api/catalogos/diligencias-realizadas?codigoTipoDiligencia={_diligencia.Tipo}");

        _diligenciasRealizadas =
        resultado ?? new List<DiligenciaRealizadaItem>();
    }

    private async Task CargarReceptoresAsync()
    {
        _receptores = await ApiClient.GetAsync<List<CatalogoItem>>(
            "/api/Catalogos/receptores") ?? new();
    }

    private async Task CargarModelosEstampeAsync()
    {
        if (_diligencia is null) return;
        _modelosEstampe = await ApiClient.GetAsync<List<ModeloEstampeItem>>(
            "/api/modelos-estampe") ?? [];
    }

    private IEnumerable<ModeloEstampeItem> ModelosAplicables =>
        _modelosEstampe.OrderBy(x => x.Nombre);

    private void CambiarModeloEstampe()
    {
        _estampe = string.Empty;
        GenerarBorradorEstampe();
    }

    private static string NombreResultadoModelo(int? resultado) => resultado switch
    {
        1 => "positiva", 2 => "negativa", _ => "cualquier resultado"
    };

    private void SeleccionarGestion()
    {
        _monto = _reciboExistente?.ValorGestion ?? _diligenciasRealizadas.FirstOrDefault(x => x.Id == _diligenciaRealizadaId)?.Arancel;
        _estampe = string.Empty;
        SeleccionarModeloRelacionado();
    }
    private bool ValidarMonto()
    {
        if (!_monto.HasValue) { _mensaje = "Ingrese el valor de la gestión; use 0 si no tiene cobro."; return false; }
        try { Jurigest.Domain.Judicial.MontoEstampe.Validar(_monto.Value); Jurigest.Domain.Judicial.MontoEstampe.Validar(_totalAdicionales); Jurigest.Domain.Judicial.MontoEstampe.Validar(TotalRecibo); if (_cuantiaRecibo.HasValue) Jurigest.Domain.Judicial.MontoEstampe.Validar(_cuantiaRecibo.Value); return true; }
        catch (ArgumentException ex) { _mensaje = ex.Message; return false; }
    }
    private void ActualizarMontoEstampe()
    {
        if (!string.IsNullOrWhiteSpace(_estampe) && ValidarMonto())
            _estampe = Jurigest.Domain.Judicial.MontoEstampe.Aplicar(_estampe, _monto!.Value);
    }
    private void SeleccionarModeloRelacionado()
    {
        var relacionado = _modelosEstampe
            .Where(x => x.DiligenciaRealizadaId == _diligenciaRealizadaId &&
                (!x.Resultado.HasValue || x.Resultado == _resultado))
            .OrderByDescending(x => x.Resultado.HasValue)
            .FirstOrDefault();
        relacionado ??= _modelosEstampe
            .Where(x => !x.DiligenciaRealizadaId.HasValue &&
                (!x.Resultado.HasValue || x.Resultado == _resultado))
            .OrderByDescending(x => x.Resultado.HasValue)
            .FirstOrDefault();
        _modeloEstampeId = relacionado?.Id;
    }

    private async Task AgregarDiligenciaRealizadaAsync()
    {
        if (_diligencia is null || string.IsNullOrWhiteSpace(_nuevaDiligencia))
        {
            _mensaje = "Indique el nombre de la diligencia realizada.";
            return;
        }
        _guardandoCatalogo = true;
        _mensaje = null;
        try
        {
            using var response = await ApiClient.PostAsync(
                "/api/Catalogos/diligencias-realizadas",
                JsonContent.Create(new { nombre = _nuevaDiligencia.Trim(), codigoTipoDiligencia = _diligencia.Tipo }));
            await VerificarRespuestaAsync(response, "agregar la diligencia realizada");
            var creada = await response.Content.ReadFromJsonAsync<DiligenciaRealizadaItem>()
                ?? throw new InvalidOperationException("La API no devolvió la diligencia creada.");
            await CargarDiligenciasRealizadasAsync();
            _diligenciaRealizadaId = creada.Id;
            SeleccionarGestion();
            _nuevaDiligencia = string.Empty;
            _mostrarAgregarDiligencia = false;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", forceLoad: true); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _mensaje = ex.Message; }
        finally { _guardandoCatalogo = false; }
    }

    private async Task AgregarReceptorAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoReceptor))
        {
            _mensaje = "Indique el nombre del receptor judicial.";
            return;
        }
        _guardandoCatalogo = true;
        _mensaje = null;
        try
        {
            using var response = await ApiClient.PostAsync(
                "/api/Catalogos/receptores", JsonContent.Create(new { nombre = _nuevoReceptor.Trim() }));
            await VerificarRespuestaAsync(response, "agregar el receptor judicial");
            var creado = await response.Content.ReadFromJsonAsync<CatalogoItem>()
                ?? throw new InvalidOperationException("La API no devolvió el receptor creado.");
            await CargarReceptoresAsync();
            _receptorJudicial = creado.Nombre;
            _nuevoReceptor = string.Empty;
            _mostrarAgregarReceptor = false;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", forceLoad: true); }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _mensaje = ex.Message; }
        finally { _guardandoCatalogo = false; }
    }

    private void CargarResultadoExistente()
    {
        if (_diligencia is null ||
            _diligencia.Resultado == 0)
        {
            return;
        }

        _diligenciaRealizadaId =
            _diligencia.DiligenciaRealizadaId;

        _monto = _reciboExistente?.ValorGestion ?? 0m;
        _abogadoRecibo = _reciboExistente?.Abogado;
        _numeroOperacion = _reciboExistente?.NumeroOperacion;
        _cuantiaRecibo = _reciboExistente?.Cuantia;
        _observacionRecibo = _reciboExistente?.Observacion;
        _detalleAdicionales = _reciboExistente?.DetalleAdicionales;
        _totalAdicionales = _reciboExistente?.TotalAdicionales ?? 0m;
        _resultado =
            _diligencia.Resultado;

        _fechaGestion =
            _diligencia.FechaGestion
            ?? DateTime.Now;

        _estampe =
            _diligencia.Estampe
            ?? string.Empty;
    }

    private void HabilitarEdicionResultado()
    {
        _editandoResultado = true;

        _mensaje = null;

        _guardado = false;
    }

    private void CancelarEdicion()
    {
        _editandoResultado = false;

        _mensaje = null;

        _guardado = false;

        CargarResultadoExistente();
    }

    private void Volver()
{
    Navigation.NavigateTo(
        $"/causas/buscar?rit={Uri.EscapeDataString(_causa?.Rit ?? string.Empty)}");
}

private void GenerarBorradorEstampe()
{
    _mensaje = null;
    _guardado = false;

    if (_causa is null ||
        _diligencia is null)
    {
        _mensaje =
            "No existen antecedentes suficientes para generar el estampe.";

        return;
    }

    if (!_resultado.HasValue ||
        _resultado.Value <= 0)
    {
        _mensaje =
            "Debe indicar primero la clasificación del resultado.";

        return;
    }

    if (!_fechaGestion.HasValue)
    {
        _mensaje =
            "Debe indicar primero la fecha de gestión.";

        return;
    }

    var diligenciaRealizada =
        _diligenciasRealizadas.FirstOrDefault(
            x =>
                _diligenciaRealizadaId.HasValue &&
                x.Id == _diligenciaRealizadaId.Value);

    if (diligenciaRealizada is null)
    {
        _mensaje =
            "Debe seleccionar una diligencia realizada válida.";

        return;
    }

    try
    {
        if (!ValidarMonto()) return;
        var modeloSeleccionado = _modelosEstampe.FirstOrDefault(x => x.Id == _modeloEstampeId);
        var modelo = modeloSeleccionado?.Contenido;
        _estampe =
            GeneradorEstampe.Generar(
                _causa.Rit,
                _causa.Tribunal,
                _causa.Descripcion,
                diligenciaRealizada.Nombre,
                modeloSeleccionado is null ? TipoDiligencia.Otro : (TipoDiligencia)modeloSeleccionado.TipoDiligencia,
                diligenciaRealizada.Nombre,
                (ResultadoDiligencia)_resultado.Value,
                string.Empty,
                _fechaGestion.Value,
                _receptorJudicial,
                _diligencia.Direccion,
                _diligencia.Comuna,
                modelo: modelo, monto: _monto,
                abogado: _abogadoRecibo,
                rutDemandado: _causa.Demandados.FirstOrDefault(x => x.EsPrincipal)?.Rut,
                materia: _materiaEstampe);
    }
    catch (ArgumentException ex)
    {
        _mensaje =
            ex.Message;
    }
}

private async Task ImprimirEstampeAsync()
{
    if (string.IsNullOrWhiteSpace(_diligencia?.Estampe)) return;
    await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/imprimir-documento.js");
    await modulo.InvokeVoidAsync("imprimirDocumento", "Estampe", _diligencia.Estampe);
}

private async Task GuardarResultadoAsync()
{
    _mensaje = null;
    _guardado = false;

    if (_diligencia is null)
    {
        _mensaje =
            "No existe una diligencia disponible para registrar.";

        return;
    }

    if (!_diligenciaRealizadaId.HasValue ||
        _diligenciaRealizadaId.Value == Guid.Empty)
    {
        _mensaje =
            "Debe indicar la diligencia realizada.";

        return;
    }

    if (!_resultado.HasValue ||
        _resultado.Value <= 0)
    {
        _mensaje =
            "Debe indicar la clasificación del resultado.";

        return;
    }
        if (!_fechaGestion.HasValue)
        {
            _mensaje =
                "Debe indicar la fecha de gestión.";

            return;
        }

        if (string.IsNullOrWhiteSpace(_estampe))
        {
            _mensaje =
                "Debe ingresar el estampe de la diligencia.";

            return;
        }

        if (!ValidarMonto()) return;
        ActualizarMontoEstampe();
        _guardando = true;

        try
        {
            if (!string.IsNullOrWhiteSpace(_receptorJudicial) &&
                _receptorJudicial != _diligencia.ReceptorJudicial)
            {
                using var asignacion = await ApiClient.PutAsync(
                    $"/api/Diligencias/{_diligencia.Id}/asignar-receptor",
                    JsonContent.Create(new { receptorJudicial = _receptorJudicial }));
                await VerificarRespuestaAsync(asignacion, "asignar el receptor judicial");
            }
            using var response =
                await ApiClient.PutAsync(
                    $"/api/Diligencias/{_diligencia.Id}/resultado",
                    JsonContent.Create(
                        new
                        {
                            diligenciaRealizadaId =
                                _diligenciaRealizadaId.Value,

                            resultado =
                                _resultado.Value,

                            monto = _monto,
                            abogado = _abogadoRecibo,
                            numeroOperacion = _numeroOperacion,
                            cuantia = _cuantiaRecibo,
                            observacionRecibo = _observacionRecibo,
                            detalleAdicionales = _detalleAdicionales,
                            totalAdicionales = _totalAdicionales,
                            resultadoDetalle = string.Empty,

                            fechaGestion =
                                _fechaGestion.Value,

                            estampe =
                                _estampe.Trim()
                        }));

            await VerificarRespuestaAsync(
                response,
                "registrar el resultado de la diligencia");

            _guardado = true;

            _mensaje =
                "Resultado de diligencia registrado correctamente.";

            await CargarUltimaDiligenciaAsync();

            CargarResultadoExistente();

            _editandoResultado = false;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException)
        {
            _mensaje =
                ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private static async Task VerificarRespuestaAsync(
        HttpResponseMessage response,
        string operacion)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        var detalle =
            await response.Content
                .ReadAsStringAsync();

        throw new InvalidOperationException(
            $"No fue posible {operacion}. " +
            $"HTTP {(int)response.StatusCode}. " +
            detalle);
    }

    private static string ObtenerNombreResultado(
        int resultado)
    {
        return resultado switch
        {
            1 => "Positiva",
            2 => "Negativa",
            _ => "Sin resultado"
        };
    }

