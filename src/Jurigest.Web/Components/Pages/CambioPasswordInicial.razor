@page "/password/cambio-inicial"
@attribute [Authorize]

<PageTitle>Cambiar contraseña | Jurigest Enterprise</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3">Cambia tu contraseña</h1>
                    <p class="text-muted">Por seguridad debes reemplazar la contraseña temporal antes de continuar.</p>

                    @if (!string.IsNullOrWhiteSpace(MensajeError))
                    {
                        <div class="alert alert-danger" role="alert">@MensajeError</div>
                    }

                    <form method="post" action="/auth/password/cambio-inicial">
                        <AntiforgeryToken />
                        <div class="mb-3">
                            <label for="nuevaPassword" class="form-label">Nueva contraseña</label>
                            <input id="nuevaPassword" name="nuevaPassword" type="password"
                                   class="form-control" minlength="12" autocomplete="new-password" required />
                            <small class="text-muted">Debe contener al menos 12 caracteres.</small>
                        </div>
                        <div class="mb-4">
                            <label for="confirmacion" class="form-label">Confirmar nueva contraseña</label>
                            <input id="confirmacion" name="confirmacion" type="password"
                                   class="form-control" minlength="12" autocomplete="new-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Guardar nueva contraseña</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? MensajeError => Error switch
    {
        "campos" => "Completa y confirma la nueva contraseña.",
        "coincidencia" => "Las contraseñas ingresadas no coinciden.",
        "longitud" => "La contraseña debe tener al menos 12 caracteres.",
        "sesion" => "La sesión expiró. Inicia sesión nuevamente.",
        _ => null
    };
}
