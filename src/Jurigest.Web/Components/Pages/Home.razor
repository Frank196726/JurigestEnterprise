@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Inicio | Jurigest Enterprise</PageTitle>

<AuthorizeView>
    <Authorized Context="sesion">
        <h1>Bienvenido, @sesion.User.Identity?.Name</h1>

        <p>
            La sesión de Jurigest Enterprise está activa.
        </p>

        <form method="post"
              action="/auth/logout">
            <AntiforgeryToken />

            <button class="btn btn-outline-danger"
                    type="submit">
                Cerrar sesión
            </button>
        </form>
    </Authorized>
</AuthorizeView>
