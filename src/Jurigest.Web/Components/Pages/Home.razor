@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Jurigest.Web.Models
@using Jurigest.Web.Security
@attribute [Authorize]
@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Panel ejecutivo | Jurigest Enterprise</PageTitle>

<AuthorizeView>
<Authorized Context="sesion">
<section class="dashboard">
    <header class="welcome">
        <div><span class="eyebrow">Panel ejecutivo diario</span><h1>Buenos días, @sesion.User.Identity?.Name</h1><p>Prioridades y acciones para la gestión jurídica de hoy.</p></div>
        <div class="date-card"><small>Hoy</small><strong>@FechaActual</strong></div>
    </header>

    <section class="search-card">
        <div><span class="eyebrow">Acción directa</span><h2>Búsqueda rápida por ROL / RIT</h2></div>
        <form class="rol-search" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
            <label><span class="sr-only">Número de ROL o RIT</span><input @bind="_rit" placeholder="Ej. C-1234-2026" maxlength="50" /></label>
            <button type="submit" disabled="@_buscando">@(_buscando ? "Buscando…" : "Buscar")</button>
        </form>
        @if (_busquedaRealizada && _causaEncontrada is null)
        {
            <div class="search-result warning"><div><strong>El ROL/RIT no está registrado</strong><p>Crea la causa para ingresar el nuevo encargo.</p></div><button class="action secondary" @onclick="CrearRol">Crear ROL</button></div>
        }
else if (_causaEncontrada is not null)
{
    <div class="search-result found">

        <div>
            <strong>
                @_causaEncontrada.Rit · @_causaEncontrada.Tribunal
            </strong>

            <p>
                @_causaEncontrada.Descripcion
            </p>
        </div>

        <div style="
            display:flex;
            gap:.5rem;
            flex-wrap:wrap;
            justify-content:flex-end;">

            <button type="button"
                    class="action secondary"
                    @onclick="ModificarRol">
                Modificar ROL
            </button>

            <button type="button"
                    class="action secondary"
                    @onclick="NuevaDiligencia">
                Nueva diligencia
            </button>

            <button type="button"
                    class="action"
                    @onclick="RegistrarResultado">
                Registrar resultado
            </button>

            <button type="button"
                    class="action"
                    @onclick="VerHistorial">
                Historial
            </button>

        </div>

    </div>
}
    </section>

    @if (_cargando) { <div class="state-card">Cargando resumen ejecutivo…</div> }
    else if (!string.IsNullOrWhiteSpace(_mensajeError)) { <div class="state-card error">@_mensajeError</div> }
    else if (_panel is not null)
    {
        <div class="summary-grid">
            <section class="summary-card">
                <div class="card-heading"><div><span class="eyebrow">Causas encargadas</span><h2>Tiempo sin gestionar</h2></div><span class="total">@_panel.TotalCausas</span></div>
                <div class="metrics">
                    <article class="metric normal"><strong>@_panel.CausasPorAntiguedad.Hasta10Dias</strong><span>0–10 días</span><small>Seguimiento normal</small></article>
                    <article class="metric attention"><strong>@_panel.CausasPorAntiguedad.Entre11Y15Dias</strong><span>11–15 días</span><small>Requieren revisión</small></article>
                    <article class="metric priority"><strong>@_panel.CausasPorAntiguedad.MasDe15Dias</strong><span>+15 días</span><small>Atención prioritaria</small></article>
                </div>
                <a class="text-link" href="/causas">Revisar causas →</a>
            </section>
            <section class="summary-card">
                <div class="card-heading"><div><span class="eyebrow">Diligencias</span><h2>Vencimientos y plazos</h2></div></div>
                <div class="deadline-list">
                    <a class="deadline critical" href="/vencimientos?plazo=vencidas"><span>Vencidas</span><strong>@_panel.DiligenciasPorPlazo.Vencidas</strong></a>
                    <a class="deadline urgent" href="/vencimientos?plazo=hoy"><span>Vencen hoy</span><strong>@_panel.DiligenciasPorPlazo.VencenHoy</strong></a>
                    <a class="deadline" href="/vencimientos?plazo=proximos3"><span>Próximos 3 días</span><strong>@_panel.DiligenciasPorPlazo.Proximos3Dias</strong></a>
                    <a class="deadline" href="/vencimientos?plazo=4a7"><span>Entre 4 y 7 días</span><strong>@_panel.DiligenciasPorPlazo.Entre4Y7Dias</strong></a>
                    <a class="deadline muted" href="/vencimientos?plazo=posteriores"><span>Después de 7 días</span><strong>@_panel.DiligenciasPorPlazo.Posteriores</strong></a>
                </div>
                <a class="text-link" href="/vencimientos">Gestionar vencimientos →</a>
            </section>
        </div>
    }

    <section class="token-card"><div><span class="eyebrow">Integraciones</span><h2>Conexión de access tokens</h2><p>Este módulo se implementará en la etapa final.</p></div><span class="pending-badge">Pendiente</span></section>
</section>
</Authorized>
</AuthorizeView>

@code {
        private string _rit = string.Empty;
        private bool _cargando = true, _buscando, _busquedaRealizada;
        private string? _mensajeError;
        private PanelEjecutivoResumen? _panel;
        private CausaEncontradaResumen? _causaEncontrada;

        protected override async Task OnInitializedAsync()
    {
        try { _panel = await ApiClient.GetAsync<PanelEjecutivoResumen>("/api/Causas/panel-ejecutivo"); }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _mensajeError = "No fue posible cargar el resumen. Inténtalo nuevamente."; }
        finally { _cargando = false; }
    }

        private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(_rit)) return;
        _buscando = true; _busquedaRealizada = false; _causaEncontrada = null; _mensajeError = null;
        try { _causaEncontrada = await ApiClient.GetAsync<CausaEncontradaResumen>($"/api/Causas/rit/{Uri.EscapeDataString(_rit.Trim())}"); _busquedaRealizada = true; }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _mensajeError = "No fue posible completar la búsqueda."; }
        finally { _buscando = false; }
    }

        private void CrearRol() =>
            Navigation.NavigateTo(
                $"/causas?rit={Uri.EscapeDataString(_rit.Trim())}");

        private void ModificarRol() =>
            Navigation.NavigateTo(
                $"/causas/{_causaEncontrada!.Id}/editar");

        private void NuevaDiligencia() =>
            Navigation.NavigateTo(
                $"/causas/{_causaEncontrada!.Id}/diligencias/nueva");

        private void RegistrarResultado() =>
            Navigation.NavigateTo(
                $"/causas/{_causaEncontrada!.Id}/diligencias/registrar");

        private void VerHistorial() =>
            Navigation.NavigateTo(
               $"/causas/buscar?rit={Uri.EscapeDataString(_causaEncontrada!.Rit)}");

        private static string FechaActual =>
            DateTime.Today.ToString(
                "dddd, d 'de' MMMM",
        CultureInfo.GetCultureInfo("es-CL"));
    }
}
