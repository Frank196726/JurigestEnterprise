@page "/login"
@layout RecoveryLayout

<PageTitle>Iniciar sesión | Jurigest Enterprise</PageTitle>

<section class="login-card">
    <span class="eyebrow">Acceso seguro</span>

    <h1>Inicia sesión</h1>

    <p class="intro">
        Ingresa tus credenciales para acceder a Jurigest Enterprise.
    </p>

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <div class="alert-error" role="alert">
            @MensajeError
        </div>
    }

    <form method="post"
          action="/auth/login">
        <AntiforgeryToken />

        <div class="field">
            <label for="email">Correo electrónico</label>

            <input id="email"
                   name="email"
                   type="email"
                   autocomplete="username"
                   required
                   autofocus />
        </div>

        <div class="field">
            <label for="password">Contraseña</label>

            <input id="password"
                   name="password"
                   type="password"
                   autocomplete="current-password"
                   required />
        </div>

        <button class="submit-button"
                type="submit">
            Ingresar
        </button>
    </form>

    <a class="recovery-link"
       href="/password/recuperacion">
        ¿Olvidaste tu contraseña?
    </a>

    <p class="security-note">
        Tu sesión está protegida y los tokens no se almacenan
        en el navegador.
    </p>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? MensajeError =>
        Error?.Trim().ToLowerInvariant() switch
        {
            "campos" =>
                "Debes ingresar tu correo y contraseña.",

            "credenciales" =>
                "El correo o la contraseña no son válidos.",

            "limite" =>
                "Se realizaron demasiados intentos. " +
                "Espera unos minutos antes de continuar.",

            "solicitud" =>
                "La solicitud de acceso expiró. Inténtalo nuevamente.",

            "servicio" =>
                "El servicio no entregó una respuesta válida.",

            _ => null
        };
}