@page "/login"
@layout RecoveryLayout
@using Microsoft.AspNetCore.Components

<PageTitle>Iniciar sesión - Jurigest Enterprise</PageTitle>

<section class="login-card">
    <span class="eyebrow">Gestión judicial</span>

    <h1>Iniciar sesión</h1>

    <p class="intro">
        Ingresa con tu cuenta de Jurigest Enterprise.
    </p>

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <div class="alert-error"
             role="alert">
            @MensajeError
        </div>
    }

    @if (ClaveActualizada)
    {
        <div class="alert alert-success" role="status">
            Contraseña actualizada. Ya puedes iniciar sesión con tu nueva clave.
        </div>
    }

    <form method="post"
          action="/auth/login">

        <AntiforgeryToken />

        <div class="field">
            <label for="email">
                Correo electrónico
            </label>

            <input id="email"
                   name="email"
                   type="email"
                   autocomplete="username"
                   placeholder="usuario@jurigest.local"
                   required />
        </div>

        <div class="field">
            <label for="password">
                Contraseña
            </label>

            <input id="password"
                   name="password"
                   type="password"
                   autocomplete="current-password"
                   required />
        </div>

        <button type="submit"
                class="submit-button">
            Iniciar sesión
        </button>
    </form>

    <a class="recovery-link"
       href="/password/recuperacion">
        ¿Olvidó su contraseña?
    </a>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "claveActualizada")]
    private bool ClaveActualizada { get; set; }

    private string? MensajeError =>
        Error switch
        {
            "campos" =>
                "Debe indicar correo electrónico y contraseña.",

            "credenciales" =>
                "El correo electrónico o la contraseña no son válidos.",

            "limite" =>
                "Se realizaron demasiados intentos. Intente nuevamente más tarde.",

            "solicitud" =>
                "La solicitud de inicio de sesión no es válida.",

            "servicio" =>
                "No fue posible iniciar sesión en este momento.",

            "sesion" =>
                "La sesión expiró. Inicia sesión nuevamente.",

            _ => null
        };
}
