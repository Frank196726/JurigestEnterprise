@page "/login"
@using Microsoft.AspNetCore.Components

<PageTitle>Iniciar sesión - Jurigest Enterprise</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h1 class="h3 mb-2">
                            Jurigest Enterprise
                        </h1>

                        <p class="text-muted mb-0">
                            Gestión Judicial
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(MensajeError))
                    {
                        <div class="alert alert-danger"
                             role="alert">
                            @MensajeError
                        </div>
                    }

                    <form method="post"
                          action="/auth/login">

                        <AntiforgeryToken />

                        <div class="mb-3">
                            <label for="email"
                                   class="form-label">
                                Correo electrónico
                            </label>

                            <input id="email"
                                   name="email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="usuario@jurigest.local"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label for="password"
                                   class="form-label">
                                Contraseña
                            </label>

                            <input id="password"
                                   name="password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Iniciar sesión
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/password/recuperacion">
                            ¿Olvidó su contraseña?
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? MensajeError =>
        Error switch
        {
            "campos" =>
                "Debe indicar correo electrónico y contraseña.",

            "credenciales" =>
                "El correo electrónico o la contraseña no son válidos.",

            "limite" =>
                "Se realizaron demasiados intentos. Intente nuevamente más tarde.",

            "solicitud" =>
                "La solicitud de inicio de sesión no es válida.",

            "servicio" =>
                "No fue posible iniciar sesión en este momento.",

            _ => null
        };
}