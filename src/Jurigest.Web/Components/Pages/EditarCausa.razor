@page "/causas/{CausaId:guid}/editar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "CausasEscritura")]

@using System.Net.Http.Json
@using Jurigest.Web.Components.Shared
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Modificar ROL | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>
            <h1>Modificar ROL</h1>

            @if (_causa is not null)
            {
                <p>@_causa.Rit</p>
            }
        </div>
    </header>

    @if (_cargando)
    {
        <div class="state-card">
            <p>Cargando causa...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeErrorCarga))
    {
        <div class="state-card error">
            <strong>No fue posible continuar</strong>
            <p>@_mensajeErrorCarga</p>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Volver">
                ← Volver
            </button>
        </div>
    }
    else if (_causa is not null)
    {
        <div class="table-card">
            <div style="padding:1.5rem;">
                <div style="margin-bottom:1.75rem;">
                    <span class="eyebrow">Causa seleccionada</span>
                    <h2 style="margin-top:.4rem;">@_causa.Rit</h2>
                    <p class="text-muted mb-0">
                        El número de ROL no se puede modificar.
                    </p>
                </div>

                @if (!_causa.PuedeCorregirIngreso)
                {
                    <div class="alert alert-info">No se puede corregir el ingreso: existe una diligencia posterior a la primera.</div>
                }
                <fieldset disabled="@(!_causa.PuedeCorregirIngreso || _guardando)" style="display:grid; gap:1rem; margin-bottom:1rem;">
                    <label>
                        <span>Tribunal *</span>
                        <input type="text"
                               class="form-control"
                               maxlength="200"
                               @bind="_tribunal"
                               placeholder="Tribunal de la causa" />
                    </label>

                    <label>
                        <span>Carátula (demandante / demandado) *</span>
                        <textarea class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  @bind="_descripcion"
                                  placeholder="Demandante / primer apellido y primer nombre del demandado">
                        </textarea>
                        <small>Ej.: Banco Del Estado de Chile / Maldonado Julio. Esta carátula es independiente del nombre completo en los antecedentes del demandado.</small>
		    </label>

		    <label>
    			<span>Fecha de encargo *</span>
    			<input type="date"
           			class="form-control"
           			@bind="_fechaEncargoCausa" />
		    </label>
                    @if (_causa.DiligenciaId.HasValue)
                    {
                    <label>
                            <span>Fecha de diligencia / fecha programada *</span>
                            <input type="date" class="form-control" @bind="_fechaProgramada" />
                     </label>
                        <label>
                            <span>Diligencia encargada *</span>
                            <select class="form-control" @bind="_diligenciaEncargadaId">
                                <option value="">Conservar: @_causa.DiligenciaEncargada</option>
                                @foreach (var item in _encargos)
                                {
                                    <option value="@item.Id">@item.Nombre</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Receptor asignado</span>
                            <select class="form-control" @bind="_receptorJudicial">
                                <option value="">No asignado</option>
                                @foreach (var receptor in _receptores)
                                {
                                    <option value="@receptor.Nombre">@receptor.Nombre</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p>Esta causa todavía no tiene una diligencia inicial registrada.</p>
                    }
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="alert @(_guardado ? "alert-success" : "alert-danger")"
                         style="margin-bottom:1rem;">
                        @_mensaje
                    </div>
                }

                <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
                    <button type="button" class="btn btn-outline-primary" disabled="@(_guardando || _cargandoMembrete)" @onclick="AbrirMembreteAsync">
                        @(_cargandoMembrete ? "Cargando membrete..." : "Imprimir membrete")
                    </button>
                    <AuthorizeView Policy="DiligenciasGestion">
                        @if (_causa.DiligenciaId is Guid diligenciaId)
                        {
                            <a class="btn btn-outline-primary" href="@($"/diligencias/{diligenciaId}/vehiculos")">Agregar vehículo</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary" disabled title="Registre una diligencia para agregar vehículos.">Agregar vehículo</button>
                        }
                    </AuthorizeView>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(_guardando || !_causa.PuedeCorregirIngreso)"
                            @onclick="GuardarAsync">
                        @(_guardando ? "Guardando..." : "Guardar cambios")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@_guardando"
                            @onclick="Volver">
                        ← Volver
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@if (_mostrarMembrete && _causa is not null)
{
    <MembreteDialog Personas="_personasMembrete" Direcciones="_direccionesMembrete" Rol="@_causa.Rit"
        Tribunal="@_tribunal" Caratula="@_descripcion" Abogado="@_abogadoMembrete"
        FechaEncargo="_fechaEncargoCausa" FechaProgramada="_fechaProgramada" Encargo="@(_encargos.FirstOrDefault(x => x.Id == _diligenciaEncargadaId)?.Nombre ?? _causa.DiligenciaEncargada ?? string.Empty)" Cerrar="() => _mostrarMembrete = false" />
}

@code {
    private bool _mostrarMembrete, _cargandoMembrete;
    private List<string> _personasMembrete = new(), _direccionesMembrete = new();
    private string _abogadoMembrete = string.Empty;
    private sealed record EncargoMembrete(string? Observaciones);
    private async Task AbrirMembreteAsync()
    {
        _cargandoMembrete = true;
        _mensaje = null;
        try
        {
            var causa = await ApiClient.GetAsync<CausaResumen>($"/api/Causas/{CausaId}");
            if (causa is null) { _mensaje = "La causa no está disponible."; return; }
            var personas = new List<string>();
            void Persona(string? nombre, string rol)
            {
                if (!string.IsNullOrWhiteSpace(nombre)) personas.Add($"{nombre.Trim()} — {rol}");
            }
            foreach (var parte in causa.Demandados)
            {
                Persona(parte.Nombre, parte.TipoPersona == 2 ? "Demandado / Razón social" : "Demandado");
                Persona(parte.RepresentanteLegal, $"Representante de {parte.Nombre}");
                foreach (var aval in parte.Avales)
                {
                    Persona(aval.Nombre, aval.TipoPersona == 2 ? "Aval solidario / Razón social" : "Aval solidario");
                    Persona(aval.RepresentanteLegal, $"Representante de {aval.Nombre}");
                }
            }
            var diligencias = await ApiClient.GetAsync<List<DiligenciaResumen>>($"/api/Diligencias/causa/{CausaId}") ?? new();
            _personasMembrete = personas.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            _direccionesMembrete = diligencias.Where(x => !string.IsNullOrWhiteSpace(x.Direccion))
                .Select(x => string.Join(", comuna de ", new[] { x.Direccion, x.Comuna }.Where(y => !string.IsNullOrWhiteSpace(y))))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            _abogadoMembrete = string.Empty;
            if (_causa?.DiligenciaId is Guid id)
            {
                var encargo = await ApiClient.GetAsync<EncargoMembrete>($"/api/diligencias/{id}");
                var observaciones = encargo?.Observaciones ?? string.Empty;
                const string inicio = "Abogado responsable: ";
                var posicion = observaciones.IndexOf(inicio, StringComparison.OrdinalIgnoreCase);
                if (posicion >= 0)
                {
                    var abogado = observaciones[(posicion + inicio.Length)..];
                    var fin = abogado.IndexOf(". Fecha de retiro:", StringComparison.OrdinalIgnoreCase);
                    _abogadoMembrete = (fin >= 0 ? abogado[..fin] : abogado).Trim().TrimEnd('.');
                }
            }
            _mostrarMembrete = true;
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _mensaje = "No fue posible cargar los datos del membrete."; }
        finally { _cargandoMembrete = false; }
    }

    [Parameter]
    public Guid CausaId { get; set; }

    private CausaEdicion? _causa;
    private DateTime? _fechaEncargoCausa;
    private DateTime? _fechaProgramada;
    private Guid? _diligenciaEncargadaId;
    private List<EncargoItem> _encargos = new();
    private List<ReceptorItem> _receptores = new();
    private string _receptorJudicial = string.Empty;
    private sealed record EncargoItem(Guid Id, string Nombre);
    private sealed record ReceptorItem(Guid Id, string Nombre);
    private sealed record CausaEdicion(
    Guid Id,
    string Rit,
    string Tribunal,
    string Descripcion,
    DateTime FechaEncargoCausa,
    bool PuedeCorregirIngreso,
    Guid? DiligenciaId,
    string? DiligenciaEncargada,
    DateTime? FechaProgramada)
    {
        public string? ReceptorJudicial { get; init; }
    }
    private string _tribunal = string.Empty;
    private string _descripcion = string.Empty;
    private string? _mensaje;
    private string? _mensajeErrorCarga;
    private bool _cargando = true;
    private bool _guardando;
    private bool _guardado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _causa = await ApiClient.GetAsync<CausaEdicion>($"/api/Causas/{CausaId}");

            if (_causa is null)
            {
                _mensajeErrorCarga =
                    "La causa indicada no existe o ya no está disponible.";

                return;
            }

            _tribunal = _causa.Tribunal;
	    _descripcion = _causa.Descripcion;
	    _fechaEncargoCausa = _causa.FechaEncargoCausa;
	    _fechaProgramada = _causa.FechaProgramada;
            _receptorJudicial = _causa.ReceptorJudicial ?? string.Empty;
            if (_causa.DiligenciaId.HasValue)
            {
                _receptores = await ApiClient.GetAsync<List<ReceptorItem>>(
                    "/api/Catalogos/receptores") ?? new();
                if (!string.IsNullOrWhiteSpace(_receptorJudicial) &&
                    !_receptores.Any(x => x.Nombre == _receptorJudicial))
                    _receptores.Insert(0, new ReceptorItem(Guid.Empty, _receptorJudicial));
            }
            if (_causa.PuedeCorregirIngreso && _causa.DiligenciaId.HasValue)
                _encargos = await ApiClient.GetAsync<List<EncargoItem>>("/api/Catalogos/diligencias-encargadas") ?? new();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeErrorCarga =
                "No fue posible comunicarse con Jurigest.API.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        _mensaje = null;
        _guardado = false;
        if (_causa is null || !_causa.PuedeCorregirIngreso) return;
	if (!_fechaEncargoCausa.HasValue)
	{
    	     _mensaje = "Debe indicar la fecha de encargo.";
    	     return;
	}
        if (_causa.DiligenciaId.HasValue && !_fechaProgramada.HasValue)
        {
            _mensaje = "Debe indicar la fecha programada.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_tribunal))
        {
            _mensaje = "Debe indicar el tribunal.";
            return;
        }

        if (_tribunal.Trim().Length > 200)
        {
            _mensaje = "El tribunal no puede superar 200 caracteres.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_descripcion))
        {
            _mensaje = "Debe indicar la descripción de la causa.";
            return;
        }

        if (_descripcion.Trim().Length > 500)
        {
            _mensaje = "La carátula no puede superar 500 caracteres.";
            return;
        }

        _guardando = true;

        try
        {
            using var response =
                await ApiClient.PutAsync(
                    $"/api/Causas/{CausaId}",
                    JsonContent.Create(
                        new
                        {
                            tribunal = _tribunal.Trim(),
                            descripcion = _descripcion.Trim(),
			    fechaEncargoCausa = _fechaEncargoCausa,
                            diligenciaId = _causa.DiligenciaId,
                            diligenciaEncargadaId = _diligenciaEncargadaId,
                            fechaProgramada = _fechaProgramada,
                            receptorJudicial = string.IsNullOrWhiteSpace(_receptorJudicial)
                                ? null : _receptorJudicial
                        }));

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                _causa = await ApiClient.GetAsync<CausaEdicion>($"/api/Causas/{CausaId}");
            await VerificarRespuestaAsync(response);

            _guardado = true;
            Volver();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException)
        {
            _mensaje = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Volver()
    {
        if (_causa is null)
        {
            Navigation.NavigateTo("/causas/buscar");
            return;
        }

        Navigation.NavigateTo(
            $"/causas/buscar?rit={Uri.EscapeDataString(_causa.Rit)}");
    }

    private static async Task VerificarRespuestaAsync(
        HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        var detalle =
            await response.Content.ReadAsStringAsync();

        throw new InvalidOperationException(
            "No fue posible actualizar la causa. " +
            $"HTTP {(int)response.StatusCode}. " +
            detalle);
    }
}
