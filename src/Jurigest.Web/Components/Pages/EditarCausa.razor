@page "/causas/{CausaId:guid}/editar"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Net.Http.Json
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Modificar ROL | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>
            <h1>Modificar ROL</h1>

            @if (_causa is not null)
            {
                <p>@_causa.Rit</p>
            }
        </div>
    </header>

    @if (_cargando)
    {
        <div class="state-card">
            <p>Cargando causa...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeErrorCarga))
    {
        <div class="state-card error">
            <strong>No fue posible continuar</strong>
            <p>@_mensajeErrorCarga</p>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="Volver">
                ← Volver
            </button>
        </div>
    }
    else if (_causa is not null)
    {
        <div class="table-card">
            <div style="padding:1.5rem;">
                <div style="margin-bottom:1.75rem;">
                    <span class="eyebrow">Causa seleccionada</span>
                    <h2 style="margin-top:.4rem;">@_causa.Rit</h2>
                    <p class="text-muted mb-0">
                        El número de ROL no se puede modificar.
                    </p>
                </div>

                @if (!_causa.PuedeCorregirIngreso)
                {
                    <div class="alert alert-info">No se puede corregir el ingreso: existe una diligencia posterior a la primera.</div>
                }
                <fieldset disabled="@(!_causa.PuedeCorregirIngreso || _guardando)" style="display:grid; gap:1rem; margin-bottom:1rem;">
                    <label>
                        <span>Tribunal *</span>
                        <input type="text"
                               class="form-control"
                               maxlength="200"
                               @bind="_tribunal"
                               placeholder="Tribunal de la causa" />
                    </label>

                    <label>
                        <span>Carátula (demandante / demandado) *</span>
                        <textarea class="form-control"
                                  rows="5"
                                  maxlength="500"
                                  @bind="_descripcion"
                                  placeholder="Carátula o descripción de la causa">
                        </textarea>
		    </label>

		    <label>
    			<span>Fecha de encargo *</span>
    			<input type="date"
           			class="form-control"
           			@bind="_fechaEncargoCausa" />
		    </label>
                    @if (_causa.DiligenciaId.HasValue)
                    {
                    <label>
                            <span>Fecha de diligencia / fecha programada *</span>
                            <input type="date" class="form-control" @bind="_fechaProgramada" />
                     </label>
                        <label>
                            <span>Diligencia encargada *</span>
                            <select class="form-control" @bind="_diligenciaEncargadaId">
                                <option value="">Conservar: @_causa.DiligenciaEncargada</option>
                                @foreach (var item in _encargos)
                                {
                                    <option value="@item.Id">@item.Nombre</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <p>Esta causa todavía no tiene una diligencia inicial registrada.</p>
                    }
                </fieldset>

                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="alert @(_guardado ? "alert-success" : "alert-danger")"
                         style="margin-bottom:1rem;">
                        @_mensaje
                    </div>
                }

                <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(_guardando || !_causa.PuedeCorregirIngreso)"
                            @onclick="GuardarAsync">
                        @(_guardando ? "Guardando..." : "Guardar cambios")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@_guardando"
                            @onclick="Volver">
                        ← Volver
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid CausaId { get; set; }

    private CausaEdicion? _causa;
    private DateTime? _fechaEncargoCausa;
    private DateTime? _fechaProgramada;
    private Guid? _diligenciaEncargadaId;
    private List<EncargoItem> _encargos = new();
    private sealed record EncargoItem(Guid Id, string Nombre);
    private sealed record CausaEdicion(
    Guid Id,
    string Rit,
    string Tribunal,
    string Descripcion,
    DateTime FechaEncargoCausa,
    bool PuedeCorregirIngreso,
    Guid? DiligenciaId,
    string? DiligenciaEncargada,
    DateTime? FechaProgramada);
    private string _tribunal = string.Empty;
    private string _descripcion = string.Empty;
    private string? _mensaje;
    private string? _mensajeErrorCarga;
    private bool _cargando = true;
    private bool _guardando;
    private bool _guardado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _causa = await ApiClient.GetAsync<CausaEdicion>($"/api/Causas/{CausaId}");

            if (_causa is null)
            {
                _mensajeErrorCarga =
                    "La causa indicada no existe o ya no está disponible.";

                return;
            }

            _tribunal = _causa.Tribunal;
	    _descripcion = _causa.Descripcion;
	    _fechaEncargoCausa = _causa.FechaEncargoCausa;
	    _fechaProgramada = _causa.FechaProgramada;
            if (_causa.PuedeCorregirIngreso && _causa.DiligenciaId.HasValue)
                _encargos = await ApiClient.GetAsync<List<EncargoItem>>("/api/Catalogos/diligencias-encargadas") ?? new();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeErrorCarga =
                "No fue posible comunicarse con Jurigest.API.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        _mensaje = null;
        _guardado = false;
        if (_causa is null || !_causa.PuedeCorregirIngreso) return;
	if (!_fechaEncargoCausa.HasValue)
	{
    	     _mensaje = "Debe indicar la fecha de encargo.";
    	     return;
	}
        if (_causa.DiligenciaId.HasValue && !_fechaProgramada.HasValue)
        {
            _mensaje = "Debe indicar la fecha programada.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_tribunal))
        {
            _mensaje = "Debe indicar el tribunal.";
            return;
        }

        if (_tribunal.Trim().Length > 200)
        {
            _mensaje = "El tribunal no puede superar 200 caracteres.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_descripcion))
        {
            _mensaje = "Debe indicar la descripción de la causa.";
            return;
        }

        if (_descripcion.Trim().Length > 500)
        {
            _mensaje = "La carátula no puede superar 500 caracteres.";
            return;
        }

        _guardando = true;

        try
        {
            using var response =
                await ApiClient.PutAsync(
                    $"/api/Causas/{CausaId}",
                    JsonContent.Create(
                        new
                        {
                            tribunal = _tribunal.Trim(),
                            descripcion = _descripcion.Trim(),
			    fechaEncargoCausa = _fechaEncargoCausa,
                            diligenciaId = _causa.DiligenciaId,
                            diligenciaEncargadaId = _diligenciaEncargadaId,
                            fechaProgramada = _fechaProgramada
                        }));

            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                _causa = await ApiClient.GetAsync<CausaEdicion>($"/api/Causas/{CausaId}");
            await VerificarRespuestaAsync(response);

            _guardado = true;
            Volver();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (Exception ex)
            when (ex is HttpRequestException
                  or InvalidOperationException)
        {
            _mensaje = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Volver()
    {
        if (_causa is null)
        {
            Navigation.NavigateTo("/causas/buscar");
            return;
        }

        Navigation.NavigateTo(
            $"/causas/buscar?rit={Uri.EscapeDataString(_causa.Rit)}");
    }

    private static async Task VerificarRespuestaAsync(
        HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        var detalle =
            await response.Content.ReadAsStringAsync();

        throw new InvalidOperationException(
            "No fue posible actualizar la causa. " +
            $"HTTP {(int)response.StatusCode}. " +
            detalle);
    }
}
