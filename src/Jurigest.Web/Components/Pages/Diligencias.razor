@page "/diligencias"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "DiligenciasLectura")]

@using Microsoft.JSInterop
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Diligencias | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>
            <h1>Diligencias</h1>
            <p>
                Consulta las diligencias asociadas a cada causa.
            </p>
        </div>

        <span class="count-badge">
            @_diligencias.Count diligencias
        </span>
    </header>

    <section class="toolbar">
        <label>
            <span>Buscar o seleccionar causa</span>

            <input type="search"
                   list="causas-disponibles"
                   value="@_busquedaCausa"
                   placeholder="Escribe RIT, tribunal o descripción"
                   autocomplete="off"
                   @onchange="BuscarCausaAsync" />

            <datalist id="causas-disponibles">
                @foreach (var causa in _causas)
                {
                    <option value="@TextoCausa(causa)"
                            label="@causa.Descripcion"></option>
                }
            </datalist>

            <small class="search-help">
                Puedes buscar por RIT, tribunal o descripción.
            </small>
        </label>

        @if (_causaSeleccionadaId != Guid.Empty)
        {
            <div class="diligencias-actions">
                <button type="button"
                        class="btn-volver"
                        @onclick="Volver">
                    ← Volver
                </button>

                <button type="button"
                        class="btn-nueva-diligencia"
                        @onclick="NuevaDiligencia">
                    + Nueva diligencia
                </button>
            </div>
        }
    </section>

    @if (_cargando)
    {
        <div class="state-card">
            <p>Cargando diligencias…</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="state-card error">
            <strong>No fue posible cargar las diligencias</strong>
            <p>@_mensajeError</p>
        </div>
    }
    else if (_causas.Count == 0)
    {
        <div class="state-card">
            <strong>No existen causas registradas</strong>
        </div>
    }
    else if (_diligencias.Count == 0)
    {
        <div class="state-card">
            <strong>La causa aún no tiene diligencias</strong>

            <p>
                Registra la primera diligencia asociada a esta causa.
            </p>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="NuevaDiligencia">
                + Registrar primera diligencia
            </button>
        </div>
    }
    else
    {
        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>Descripción</th>
                        <th>Diligencia realizada</th>
                        <th>Estado</th>
                        <th>Fecha de gestión</th>
                        <th>Receptor</th>
                        <th>Ubicación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var diligencia in _diligencias)
                    {
                        <tr @key="diligencia.Id" class="@(DiligenciaIdInicial == diligencia.Id ? "table-primary" : null)">
                            <td>
                                <strong>
                                    @diligencia.Descripcion
                                </strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(diligencia.DiligenciaRealizada) ? "Sin registrar" : diligencia.DiligenciaRealizada)
                            </td>

                            <td>
                                <span class="status status-@diligencia.Estado">
                                    @ObtenerEstado(diligencia.Estado)
                                </span>
                            </td>

                            <td>
                                @(diligencia.FechaGestion?
                                    .ToString("dd-MM-yyyy HH:mm") ?? "Sin registrar")
                            </td>

                            <td>
                                @(diligencia.ReceptorJudicial ?? "—")
                            </td>

                            <td>
                                @ObtenerUbicacion(diligencia)
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <AuthorizeView Policy="DiligenciasGestion"><a class="btn btn-sm btn-outline-secondary" href="@($"/diligencias/{diligencia.Id}/vehiculos")">Gestionar vehículos</a></AuthorizeView>
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_cargandoDocumento"
                                            @onclick="() => VerEstampe(diligencia)">Ver estampe</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_cargandoDocumento"
                                            @onclick="() => VerReciboAsync(diligencia)">Ver recibo</button>
                                @if (diligencia.Resultado == 0)
                                {
                                    <AuthorizeView Policy="DiligenciasGestion">
                                        <a class="btn btn-primary" href="@($"/causas/{_causaSeleccionadaId}/diligencias/registrar?diligenciaId={diligencia.Id}")">Registrar resultado</a>
                                    </AuthorizeView>
                                }
                                @if (diligencia.Estado == 1)
                                {
                                    <button type="button"
                                            class="btn btn-secondary"
                                            @onclick="() => ModificarDiligencia(diligencia.Id)">
                                        Modificar diligencia
                                    </button>
                                }
                                </div>
                            </td>
                        </tr>
                        @if (_documentoDiligenciaId == diligencia.Id)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="border rounded p-3 bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong>@(_verRecibo ? "Recibo" : "Estampe") — @diligencia.Descripcion</strong>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_cargandoDocumento"
                                                    @onclick="() => _documentoDiligenciaId = null">Cerrar</button>
                                        </div>
                                        @if (_cargandoDocumento)
                                        {
                                            <p>Cargando recibo...</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(_mensajeDocumento))
                                        {
                                            <p role="status">@_mensajeDocumento</p>
                                        }
                                        else if (_verRecibo && _reciboMostrar is not null)
                                        {
                                            <div id="recibo-para-imprimir" class="recibo-detalle">
                                            <fieldset class="border rounded p-3 mb-3">
                                                <legend class="fs-6">Datos del recibo <strong>R@_reciboMostrar.Numero</strong> — Abogado: @TextoRecibo(_reciboMostrar.Abogado)</legend>
                                                <dl class="mb-0">
                                                    <dt>Receptor asignado</dt><dd>@TextoRecibo(_reciboMostrar.Receptor ?? diligencia.ReceptorJudicial)</dd>
                                                    <dt>Causa</dt><dd>@(_reciboMostrar.Rol ?? _causas.FirstOrDefault(c => c.Id == _causaSeleccionadaId)?.Rit) — @(_reciboMostrar.Tribunal ?? _causas.FirstOrDefault(c => c.Id == _causaSeleccionadaId)?.Tribunal)</dd>
                                                    <dt>Caratulado</dt><dd>@(_reciboMostrar.Caratulado ?? _causas.FirstOrDefault(c => c.Id == _causaSeleccionadaId)?.Descripcion)</dd>
                                                    <dt>Diligencia encargada</dt><dd>@(_reciboMostrar.DiligenciaEncargada ?? diligencia.Descripcion)</dd>
                                                    <dt>Fecha creación</dt><dd>@_reciboMostrar.FechaEmision.ToString("dd-MM-yyyy")</dd>
                                                    <dt>Estado</dt><dd>@(_reciboMostrar.Estado == 2 ? "Pagado" : "Impago")</dd>
                                                </dl>
                                            </fieldset>
                                            <fieldset class="border rounded p-3">
                                                <legend class="fs-6">Detalle del recibo</legend>
                                                <dl class="mb-0">
                                                    <dt>Resultado</dt><dd>@_reciboMostrar.DiligenciaRealizada</dd>
                                                    <dt>N° operación</dt><dd>@TextoRecibo(_reciboMostrar.NumeroOperacion)</dd>
                                                    <dt>Cuantía</dt><dd>@(_reciboMostrar.Cuantia.HasValue ? Pesos(_reciboMostrar.Cuantia.Value) : "—")</dd>
                                                    <dt>Valor gestión</dt><dd>@Pesos(_reciboMostrar.ValorGestion)</dd>
                                                    <dt>Observación recibo</dt><dd>@TextoRecibo(_reciboMostrar.Observacion)</dd>
                                                    <dt>Detalle adicionales</dt><dd>@TextoRecibo(_reciboMostrar.DetalleAdicionales)</dd>
                                                    <dt>Total adicionales</dt><dd>@Pesos(_reciboMostrar.TotalAdicionales)</dd>
                                                    <dt>Total recibo</dt><dd><strong>@Pesos(_reciboMostrar.Monto)</strong></dd>
                                                </dl>
                                            </fieldset>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@diligencia.Estampe</div>
                                        }
                                        @if (!_cargandoDocumento && string.IsNullOrWhiteSpace(_mensajeDocumento))
                                        {
                                            <button type="button" class="btn btn-primary mt-3" @onclick="() => ImprimirAsync(diligencia)">
                                                @(_verRecibo ? "Imprimir recibo" : "Imprimir estampe")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "causaId")]
    public Guid? CausaIdInicial { get; set; }

    [SupplyParameterFromQuery(Name = "diligenciaId")]
    public Guid? DiligenciaIdInicial { get; set; }

    private readonly List<CausaResumen> _causas = [];
    private readonly List<DiligenciaResumen> _diligencias = [];

    private Guid _causaSeleccionadaId;
    private string _busquedaCausa = string.Empty;
    private string? _mensajeError;
    private bool _cargando = true;
    private Guid? _documentoDiligenciaId;
    private bool _verRecibo;
    private bool _cargandoDocumento;
    private string? _mensajeDocumento;
    private ReciboResumen? _reciboMostrar;

    private static string TextoRecibo(string? texto) => string.IsNullOrWhiteSpace(texto) ? "—" : texto;
    private static string Pesos(decimal valor) => valor.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CL"));

    private async Task ImprimirAsync(DiligenciaResumen diligencia)
    {
        var titulo = _verRecibo ? "Recibo" : "Estampe";
        string contenido;
        if (_verRecibo)
        {
            if (_reciboMostrar is null) return;
            var recibo = _reciboMostrar;
            var causa = _causas.FirstOrDefault(c => c.Id == _causaSeleccionadaId);
            contenido = $"Datos del recibo R{recibo.Numero} - Abogado: {TextoRecibo(recibo.Abogado)}\n\n" +
                $"Receptor asignado: {TextoRecibo(recibo.Receptor ?? diligencia.ReceptorJudicial)}\n" +
                $"Causa: {recibo.Rol ?? causa?.Rit} — {recibo.Tribunal ?? causa?.Tribunal}\n" +
                $"Caratulado: {recibo.Caratulado ?? causa?.Descripcion}\n" +
                $"Diligencia encargada: {recibo.DiligenciaEncargada ?? diligencia.Descripcion}\n" +
                $"Fecha creación: {recibo.FechaEmision:dd-MM-yyyy}\n" +
                $"Estado: {(recibo.Estado == 2 ? "Pagado" : "Impago")}\n\n" +
                $"Resultado: {recibo.DiligenciaRealizada}\nN° operación: {TextoRecibo(recibo.NumeroOperacion)}\n" +
                $"Cuantía: {(recibo.Cuantia.HasValue ? Pesos(recibo.Cuantia.Value) : "—")}\n" +
                $"Valor gestión: {Pesos(recibo.ValorGestion)}\nObservación recibo: {TextoRecibo(recibo.Observacion)}\n\n" +
                $"Datos adicionales\nDetalle: {TextoRecibo(recibo.DetalleAdicionales)}\n" +
                $"Total adicionales: {Pesos(recibo.TotalAdicionales)}\nTotal recibo: {Pesos(recibo.Monto)}";
            if (recibo.FechaPago.HasValue)
                contenido += $"\nFecha de pago: {recibo.FechaPago.Value:dd-MM-yyyy HH:mm}";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(diligencia.Estampe)) return;
            contenido = diligencia.Estampe;
        }
        await using var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/imprimir-documento.js");
        await modulo.InvokeVoidAsync("imprimirDocumento", titulo, contenido, _verRecibo ? "recibo-para-imprimir" : null);
    }

    private void VerEstampe(DiligenciaResumen diligencia)
    {
        _documentoDiligenciaId = diligencia.Id;
        _verRecibo = false;
        _reciboMostrar = null;
        _mensajeDocumento = string.IsNullOrWhiteSpace(diligencia.Estampe)
            ? "Esta diligencia aún no tiene un estampe registrado." : null;
    }

    private async Task VerReciboAsync(DiligenciaResumen diligencia)
    {
        if (_cargandoDocumento) return;
        _documentoDiligenciaId = diligencia.Id;
        _verRecibo = true;
        _reciboMostrar = null;
        _mensajeDocumento = null;
        _cargandoDocumento = true;
        try
        {
            var referencia = await ApiClient.GetAsync<ReciboReferencia>(
                $"/api/Recibos/diligencia/{diligencia.Id}");
            if (referencia is not null)
                _reciboMostrar = await ApiClient.GetAsync<ReciboResumen>($"/api/Recibos/{referencia.Id}");
            if (_reciboMostrar is null)
                _mensajeDocumento = "Esta diligencia aún no tiene un recibo emitido.";
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeDocumento = "No fue posible cargar el recibo. Inténtalo nuevamente.";
        }
        finally
        {
            _cargandoDocumento = false;
        }
    }

    private sealed class ReciboReferencia
    {
        public Guid Id { get; set; }
    }

    private void NuevaDiligencia()
    {
        if (_causaSeleccionadaId == Guid.Empty)
            return;

        Navigation.NavigateTo(
            $"/causas/{_causaSeleccionadaId}/diligencias/nueva");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/causas");
    }

    private void ModificarDiligencia(Guid diligenciaId)
    {
        Navigation.NavigateTo(
            $"/diligencias/{diligenciaId}/editar");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var causas =
                await ApiClient.GetAsync<List<CausaResumen>>(
                    "/api/Causas");

            if (causas is null || causas.Count == 0)
                return;

            _causas.AddRange(causas);

            _causaSeleccionadaId =
                CausaIdInicial.HasValue &&
                _causas.Any(c => c.Id == CausaIdInicial.Value)
                    ? CausaIdInicial.Value
                    : _causas[0].Id;

            _busquedaCausa = TextoCausa(
                _causas.Single(causa =>
                    causa.Id == _causaSeleccionadaId));

            await CargarDiligenciasAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "El servicio no está disponible. " +
                "Inténtalo nuevamente.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task BuscarCausaAsync(
        ChangeEventArgs args)
    {
        var busqueda = args.Value?.ToString()?.Trim();

        if (string.IsNullOrWhiteSpace(busqueda))
        {
            return;
        }

        var causa = _causas.FirstOrDefault(item =>
                TextoCausa(item).Equals(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase))
            ?? _causas.FirstOrDefault(item =>
                item.Rit.Equals(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase))
            ?? _causas.FirstOrDefault(item =>
                item.Rit.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ||
                item.Tribunal.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase) ||
                item.Descripcion.Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase));

        if (causa is null)
        {
            _mensajeError =
                "No se encontró una causa con ese criterio.";
            return;
        }

        _causaSeleccionadaId = causa.Id;
        _busquedaCausa = TextoCausa(causa);
        _cargando = true;
        _mensajeError = null;

        try
        {
            await CargarDiligenciasAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "No fue posible cargar las diligencias.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string TextoCausa(
        CausaResumen causa) =>
        $"{causa.Rit} — {causa.Tribunal}";

    private async Task CargarDiligenciasAsync()
    {
        _documentoDiligenciaId = null;
        _diligencias.Clear();

        if (_causaSeleccionadaId == Guid.Empty)
            return;

        var resultado =
            await ApiClient.GetAsync<List<DiligenciaResumen>>(
                $"/api/Diligencias/causa/{_causaSeleccionadaId}");

        if (resultado is not null)
            _diligencias.AddRange(resultado);
    }

    private static string ObtenerEstado(int estado) =>
        estado switch
        {
            1 => "Pendiente",
            2 => "En proceso",
            3 => "Completada",
            4 => "Reprogramada",
            5 => "Cancelada",
            6 => "Suspendida",
            7 => "Rechazada",
            _ => "Sin estado"
        };

    private static string ObtenerTipo(int tipo) =>
        tipo switch
        {
            1 => "Notificación",
            2 => "Requerimiento de pago",
            3 => "Embargo",
            4 => "Lanzamiento",
            5 => "Retiro de exhorto",
            6 => "Retiro de expediente",
            7 => "Incautación",
            8 => "Protesto",
            9 => "Citación",
            99 => "Otro",
            _ => "Sin tipo"
        };

    private static string ObtenerUbicacion(
        DiligenciaResumen diligencia)
    {
        var partes = new[]
        {
            diligencia.Direccion,
            diligencia.Comuna
        };

        var ubicacion =
            string.Join(
                ", ",
                partes.Where(
                    parte =>
                        !string.IsNullOrWhiteSpace(parte)));

        return string.IsNullOrWhiteSpace(ubicacion)
            ? "—"
            : ubicacion;
    }
}
