@page "/recibos"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Globalization
@using System.Net.Http.Json
@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Gestionar recibos | Jurigest Enterprise</PageTitle>

<section class="diligencias-page">

    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión financiera</span>
            <h1>Gestionar recibos</h1>
            <p>
                Recibos generados por las diligencias realizadas.
            </p>
        </div>
    </header>

    @if (_cargando)
    {
        <div class="state-card">
            <p>Cargando recibos...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_mensajeError))
    {
        <div class="state-card error">
            <strong>No fue posible cargar los recibos</strong>
            <p>@_mensajeError</p>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CargarAsync">
                Reintentar
            </button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_mensajeExito))
        {
            <div class="alert alert-success">
                @_mensajeExito
            </div>
        }

        <div class="table-card">

            <div style="padding:1.5rem;">

                <span class="eyebrow">Pendientes</span>

                <h2 style="margin-top:.4rem;">
                    Recibos pendientes de pago
                </h2>

                @if (RecibosPendientes.Count == 0)
                {
                    <p>No existen recibos pendientes.</p>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Diligencia realizada</th>
                                    <th>Fecha emisión</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var recibo in RecibosPendientes)
                                {
                                    <tr>
                                        <td>@recibo.DiligenciaRealizada</td>
                                        <td>@FormatearFecha(recibo.FechaEmision)</td>
                                        <td>@FormatearMonto(recibo.Monto)</td>
                                        <td>
                                            <strong>Pendiente</strong>
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-primary"
                                                    disabled="@(_procesandoId == recibo.Id)"
                                                    @onclick="() => MarcarPagadoAsync(recibo)">
                                                @(_procesandoId == recibo.Id
                                                    ? "Procesando..."
                                                    : "Marcar pagado")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>

        <div class="table-card"
             style="margin-top:1.5rem;">

            <div style="padding:1.5rem;">

                <span class="eyebrow">Historial</span>

                <h2 style="margin-top:.4rem;">
                    Recibos pagados
                </h2>

                @if (RecibosPagados.Count == 0)
                {
                    <p>No existen recibos pagados.</p>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Diligencia realizada</th>
                                    <th>Fecha emisión</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                    <th>Fecha pago</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var recibo in RecibosPagados)
                                {
                                    <tr>
                                        <td>@recibo.DiligenciaRealizada</td>
                                        <td>@FormatearFecha(recibo.FechaEmision)</td>
                                        <td>@FormatearMonto(recibo.Monto)</td>
                                        <td>
                                            <strong>Pagado</strong>
                                        </td>
                                        <td>
                                            @(recibo.FechaPago.HasValue
                                                ? FormatearFecha(recibo.FechaPago.Value)
                                                : "No registrada")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    }

</section>

@code {
    private const int EstadoPendiente = 1;
    private const int EstadoPagado = 2;

    private readonly List<ReciboResumen> _recibos = new();

    private bool _cargando = true;
    private Guid? _procesandoId;
    private string? _mensajeError;
    private string? _mensajeExito;

    private List<ReciboResumen> RecibosPendientes =>
        _recibos
            .Where(x => x.Estado == EstadoPendiente)
            .OrderByDescending(x => x.FechaEmision)
            .ToList();

    private List<ReciboResumen> RecibosPagados =>
        _recibos
            .Where(x => x.Estado == EstadoPagado)
            .OrderByDescending(x => x.FechaPago ?? x.FechaEmision)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _mensajeError = null;

        try
        {
            var resultado =
                await ApiClient.GetAsync<List<ReciboResumen>>(
                    "/api/Recibos");

            _recibos.Clear();

            if (resultado is not null)
            {
                _recibos.AddRange(resultado);
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                true);
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "No fue posible obtener los recibos desde el servicio.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task MarcarPagadoAsync(
        ReciboResumen recibo)
    {
        if (_procesandoId.HasValue)
        {
            return;
        }

        _procesandoId = recibo.Id;
        _mensajeError = null;
        _mensajeExito = null;

        try
        {
            using var response =
                await ApiClient.PutAsync(
                    $"/api/Recibos/{recibo.Id}/pagar",
                    JsonContent.Create(
                        new
                        {
                            fechaPago = DateTime.Now
                        }));

            if (!response.IsSuccessStatusCode)
            {
                var error =
                    await response.Content
                        .ReadFromJsonAsync<ErrorResponse>();

                _mensajeError =
                    error?.Mensaje ??
                    "No fue posible marcar el recibo como pagado.";

                return;
            }

            _mensajeExito =
                $"Recibo de {recibo.DiligenciaRealizada} " +
                $"por {FormatearMonto(recibo.Monto)} marcado como pagado.";

            await CargarAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/login",
                true);
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "No fue posible comunicar con el servicio de recibos.";
        }
        finally
        {
            _procesandoId = null;
        }
    }

    private static string FormatearMonto(decimal monto)
    {
        var cultura =
            CultureInfo.GetCultureInfo("es-CL");

        return monto.ToString("C0", cultura);
    }

    private static string FormatearFecha(DateTime fecha)
    {
        return fecha.ToString(
            "dd-MM-yyyy HH:mm");
    }

    private sealed record ErrorResponse(
        string Mensaje);
}
