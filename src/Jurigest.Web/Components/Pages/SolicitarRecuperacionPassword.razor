@page "/password/recuperacion"
@layout RecoveryLayout

<PageTitle>Recuperar contraseña | Jurigest Enterprise</PageTitle>

<section class="recovery-request-card">
    <span class="eyebrow">Seguridad de la cuenta</span>

    @if (Enviado)
    {
        <div class="status-icon">✓</div>

        <h1>Revisa tu correo</h1>

        <p class="intro">
            Si la cuenta existe, enviaremos un enlace para
            restablecer la contraseña.
        </p>

        <a class="primary-action"
           href="/login">
            Volver al inicio de sesión
        </a>
    }
    else
    {
        <h1>Recupera tu contraseña</h1>

        <p class="intro">
            Ingresa el correo asociado a tu cuenta.
            Te enviaremos instrucciones para continuar.
        </p>

        @if (!string.IsNullOrWhiteSpace(MensajeError))
        {
            <div class="alert-error" role="alert">
                @MensajeError
            </div>
        }

        <form method="post"
              action="/auth/password/recuperacion">
            <AntiforgeryToken />

            <div class="field">
                <label for="email">
                    Correo electrónico
                </label>

                <input id="email"
                       name="email"
                       type="email"
                       autocomplete="email"
                       required
                       autofocus />
            </div>

            <button class="submit-button"
                    type="submit">
                Enviar instrucciones
            </button>
        </form>

        <a class="secondary-link"
           href="/login">
            Volver al inicio de sesión
        </a>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "enviado")]
    public bool Enviado { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string? MensajeError =>
        Error?.Trim().ToLowerInvariant() switch
        {
            "campos" =>
                "Debes ingresar un correo electrónico.",

            "limite" =>
                "Se realizaron demasiadas solicitudes. " +
                "Espera unos minutos antes de continuar.",

            "solicitud" =>
                "La solicitud expiró. Inténtalo nuevamente.",

            "servicio" =>
                "No fue posible enviar las instrucciones. " +
                "Inténtalo nuevamente.",

            _ => null
        };
}