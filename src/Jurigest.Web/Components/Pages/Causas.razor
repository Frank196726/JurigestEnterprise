@page "/causas"

@rendermode InteractiveServer
@attribute [Authorize]

@using Jurigest.Web.Models
@using Jurigest.Web.Security

@inject IJurigestApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Causas | Jurigest Enterprise</PageTitle>

<section class="causes-page">

    <header class="page-heading">
        <div>
            <span class="eyebrow">Gestión judicial</span>

            <h1>Revisión de causas</h1>

            <p>
                Consulta los expedientes registrados y su estado actual.
            </p>
        </div>

        <div class="heading-actions">
            <span class="count-badge">
                @_causas.Count causas
            </span>

            <AuthorizeView Roles="Administrador,Abogado">
                <Authorized>
                    <a class="btn btn-primary" href="/causas/nueva">
                        Nueva gestión
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    @* =========================================================
       BUSCADOR
       ========================================================= *@

    <section class="toolbar">

        <label class="search-box">

            <span>Buscar</span>

            <input type="search"
                   placeholder="RIT, tribunal o descripción"
                   autocomplete="off"
                   @bind="_filtro"
                   @bind:event="oninput" />

        </label>

    </section>

    @if (_cargando)
    {
        <div class="state-card">

            <span class="spinner"></span>

            <p>Cargando causas...</p>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _mensajeError))
    {
        <div class="state-card error">

            <strong>
                No fue posible cargar las causas
            </strong>

            <p>@_mensajeError</p>

        </div>
    }
    else if (!CausasFiltradas.Any())
    {
        <div class="state-card">

            <strong>
                No se encontraron resultados
            </strong>

            <p>
                Intenta utilizar otro RIT,
                tribunal o descripción.
            </p>

        </div>
    }
    else
    {
        <div class="table-card">

            <table>

                <thead>
                    <tr>
                        <th>RIT</th>
                        <th>Tribunal</th>
                        <th>Descripción</th>
                        <th>Encargo</th>
                        <th>Última gestión</th>
                        <th>Días sin gestionar</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <AuthorizeView Roles="Administrador,Abogado,Procurador">
                            <th>Acciones</th>
                        </AuthorizeView>
                  </tr>
            </thead>

          <tbody>
            @foreach (var causa in CausasFiltradas)
            {
                <tr @key="causa.Id">

                    <td>
                        <strong class="rit">
                            @causa.Rit
                        </strong>
                    </td>

                    <td>
                        @causa.Tribunal
                    </td>

                    <td>
                        <span>
                            @causa.Descripcion
                        </span>
                    </td>

                    <td>
                        @causa.FechaEncargoCausa.ToString(
                            "dd-MM-yyyy")
                    </td>

                    <td>
                        @if (causa.FechaGestionCausa.HasValue)
                        {
                            @causa.FechaGestionCausa.Value.ToString(
                                "dd-MM-yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin gestión realizada
                            </span>
                        }
                    </td>

                    <td>
                        <strong>
                            @causa.DiasSinGestion
                        </strong>

                        <span>
                            día@(causa.DiasSinGestion == 1 ? "" : "s")
                        </span>
                    </td>

                    <td>
                        <span class="@ObtenerClasePrioridad(
                                        causa.DiasSinGestion)">
                                    @ObtenerTextoPrioridad(
                                        causa.DiasSinGestion)
                            </span>
                        </td>

                    <td>
                        <span class="@(
                            $"status status-{causa.Estado}")">

                            @ObtenerEstado(
                                causa.Estado)

                </span>
            </td>

            <AuthorizeView Roles="Administrador,Abogado,Procurador">
                <td class="actions-cell">
                    <a class="manage-action"
                       href="@($"/causas/{causa.Id}/diligencias/registrar")">
                        Gestionar diligencia
                    </a>
                </td>
            </AuthorizeView>

        </tr>
    }
</tbody>

</table>

</div>
}

</section>

@code {
    [SupplyParameterFromQuery(Name = "rit")]
    public string? RitInicial { get; set; }

    private readonly List<CausaResumen> _causas = [];
    private string _filtro = string.Empty;
    private string? _mensajeError;
    private bool _cargando = true;

    private IEnumerable<CausaResumen> CausasFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filtro))
            {
                return _causas;
            }

            var filtro = _filtro.Trim();

            return _causas.Where(causa =>
                causa.Rit.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                causa.Tribunal.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                causa.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarCausasAsync();

            if (!string.IsNullOrWhiteSpace(RitInicial))
            {
                _filtro = RitInicial.Trim();
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _mensajeError =
                "El servicio no está disponible. Inténtalo nuevamente.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarCausasAsync()
    {
        var resultado =
            await ApiClient.GetAsync<List<CausaResumen>>("/api/Causas");

        _causas.Clear();

        if (resultado is not null)
        {
            _causas.AddRange(resultado);
        }
    }

    private static string ObtenerEstado(int estado) => estado switch
    {
        1 => "Ingresada",
        2 => "En tramitación",
        3 => "Suspendida",
        4 => "Terminada",
        5 => "Archivada",
        _ => "Sin estado"
    };

    private static string ObtenerTextoPrioridad(int diasSinGestion) =>
        diasSinGestion switch
        {
            <= 10 => "Normal",
            <= 15 => "Requiere revisión",
            _ => "Atención prioritaria"
        };

    private static string ObtenerClasePrioridad(int diasSinGestion) =>
        diasSinGestion switch
        {
            <= 10 => "priority-badge priority-normal",
            <= 15 => "priority-badge priority-review",
            _ => "priority-badge priority-critical"
        };
}
