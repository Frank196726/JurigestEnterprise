# /etc/jurigest/api.env — instalar-servidor.sh lo genera con valores reales.
# Permisos: root:jurigest 640. Nunca lo copie al repositorio.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
HOME=/var/lib/jurigest
TZ=America/Santiago
AllowedHosts=__DOMINIO_API__
ReverseProxy__KnownProxy=127.0.0.1
ConnectionStrings__DefaultConnection=Server=localhost;Database=JurigestEnterprise;User Id=jurigest_app;Password=__CLAVE_SQL__;Encrypt=True;TrustServerCertificate=True
Jwt__Issuer=https://__DOMINIO_API__
Jwt__Audience=https://__DOMINIO_WEB__
Jwt__Key=__CLAVE_JWT__
Jwt__ExpirationMinutes=60
FileStorage__RootPath=/var/lib/jurigest/documentos
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__UseStartTls=true
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=
Email__Smtp__FromName=Jurigest Enterprise
Email__Smtp__RecoveryUrl=https://__DOMINIO_WEB__/password/recuperacion/confirmar
