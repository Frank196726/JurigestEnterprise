# Copie estas claves al almacén de secretos de la plataforma. No use este archivo con valores reales.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=SQL_HOST;Database=JurigestEnterprise;User Id=JURIGEST_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
Jwt__Issuer=https://api.jurigest.example.cl
Jwt__Audience=https://jurigest.example.cl
Jwt__Key=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
Jwt__ExpirationMinutes=60
Email__Smtp__Host=smtp.example.cl
Email__Smtp__Port=587
Email__Smtp__UseStartTls=true
Email__Smtp__Username=CHANGE_ME
Email__Smtp__Password=CHANGE_ME
Email__Smtp__FromAddress=no-reply@jurigest.example.cl
Email__Smtp__FromName=Jurigest Enterprise
Email__Smtp__RecoveryUrl=https://jurigest.example.cl/password/recuperacion/confirmar
Api__BaseUrl=https://api.jurigest.example.cl
